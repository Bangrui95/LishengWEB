---
import { withBase } from "../lib/url";
import { getUI, type Lang } from "../lib/i18n";
import ContactCta from "./ContactCta.astro";
import "../styles/footer.css";

interface Props {
  showCta?: boolean;
  lang?: Lang;
}
const { showCta = true, lang = "en" } = Astro.props;
const ui = getUI(lang);
const f = ui.footer;
const nav = ui.nav;
---

{showCta && (
  <ContactCta
    kicker={ui.cta.kicker}
    title={ui.cta.title}
    text={ui.cta.text}
    buttonLabel={ui.cta.button}
    secondaryLabel={ui.cta.secondary}
    secondaryHref="/services/customization/"
  />
)}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={withBase("/images/icon/logo-white.png")} alt="Lisheng logo" />
      <p>{f.desc}</p>
      <a class="footer-quote" href={withBase("/contact/")}>{ui.quote}</a>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <h2>{f.company}</h2>
        <a href={withBase("/company/")}>{f.about}</a>
        <a href={withBase("/company/honors/")}>{nav.honors}</a>
        <a href={withBase("/company/subsidiaries/")}>{nav.subsidiaries}</a>
      </div>

      <div>
        <h2>{f.factory}</h2>
        <a href={withBase("/factory/production/")}>{nav.smartFactory}</a>
        <a href={withBase("/factory/lab/")}>{nav.foodLab}</a>
        <a href={withBase("/factory/certificates/")}>{f.certifications}</a>
        <a href={withBase("/factory/tour/")}>{nav.factoryTour}</a>
      </div>

      <div>
        <h2>{f.services}</h2>
        <a href={withBase("/services/")}>{f.oemShort}</a>
        <a href={withBase("/services/customization/")}>{nav.customization}</a>
      </div>

      <div>
        <h2>{f.products}</h2>
        <a href={withBase("/products/#noodles")}>{f.noodleProducts}</a>
        <a href={withBase("/products/#flour")}>{f.flourProducts}</a>
        <a href={withBase("/products/specifications/")}>{f.specifications}</a>
      </div>

      <div>
        <h2>{f.contact}</h2>
        <a href={withBase("/contact/")}>{f.startProject}</a>
        <a href={withBase("/contact/")}>{f.requestSamples}</a>
      </div>

      <div>
        <h2>{f.news}</h2>
        <a href={withBase("/news/")}>{f.latestNews}</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>{f.rights}</p>
    <div>
      <a href={withBase("/privacy/")}>{f.privacy}</a>
      <a href={withBase("/terms/")}>{f.terms}</a>
      <a href={withBase("/contact/")}>{f.contact}</a>
    </div>
  </div>
</footer>
