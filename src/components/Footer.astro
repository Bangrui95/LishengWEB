---
import { withBase } from "../lib/url";
import ContactCta from "./ContactCta.astro";
import "../styles/footer.css";

const { showCta = true } = Astro.props;
---

{showCta && (
  <ContactCta
    secondaryLabel="Customize Your Product"
    secondaryHref="/services/customization/"
  />
)}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={withBase("/images/icon/logo-white.png")} alt="Lisheng logo" />
      <p>
        Export-ready noodle manufacturing, private label production, and
        packaging support for global food brands, importers, and foodservice
        distributors.
      </p>
      <a class="footer-quote" href={withBase("/contact/")}>Request a Quote</a>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <h2>Company</h2>
        <a href={withBase("/company/")}>About us</a>
        <a href={withBase("/company/honors/")}>Honors &amp; Awards</a>
        <a href={withBase("/company/subsidiaries/")}>Subsidiaries</a>
      </div>

      <div>
        <h2>Factory</h2>
        <a href={withBase("/factory/production/")}>Smart Factory</a>
        <a href={withBase("/factory/lab/")}>Food Lab</a>
        <a href={withBase("/factory/certificates/")}>Certifications</a>
        <a href={withBase("/factory/tour/")}>Factory Tour</a>
      </div>

      <div>
        <h2>Services</h2>
        <a href={withBase("/services/")}>OEM Manufacturing</a>
        <a href={withBase("/services/customization/")}>Product Customization</a>
      </div>

      <div>
        <h2>Products</h2>
        <a href={withBase("/products/#noodles")}>Noodle Products</a>
        <a href={withBase("/products/#flour")}>Flour Products</a>
        <a href={withBase("/products/specifications/")}>Specifications</a>
      </div>

      <div>
        <h2>Contact</h2>
        <a href={withBase("/contact/")}>Start an OEM Project</a>
        <a href={withBase("/contact/")}>Request Samples</a>
      </div>

      <div>
        <h2>News</h2>
        <a href={withBase("/news/")}>Latest News</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Lisheng. All rights reserved.</p>
    <div>
      <a href={withBase("/privacy/")}>Privacy Policy</a>
      <a href={withBase("/terms/")}>Terms</a>
      <a href={withBase("/contact/")}>Contact</a>
    </div>
  </div>
</footer>
