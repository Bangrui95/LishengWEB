---
import { withBase } from "../lib/url";
import ContactCta from "./ContactCta.astro";
import "../styles/footer.css";

const { showCta = true } = Astro.props;
---

{showCta && (
  <ContactCta
    secondaryLabel="Customize Your Product"
    secondaryHref="/services/customization/"
  />
)}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={withBase("/images/icon/logo-white.png")} alt="Lisheng logo" />
      <p>
        Export-ready noodle manufacturing, private label production, and
        packaging support for global food brands, importers, and foodservice
        distributors.
      </p>
      <a class="footer-quote" href={withBase("/contact/")}>Request a Quote</a>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <h2>Products</h2>
        <a href={withBase("/products/")}>Instant Noodles</a>
        <a href={withBase("/products/")}>Dry Noodles</a>
        <a href={withBase("/products/")}>Ramen Noodles</a>
        <a href={withBase("/products/")}>Foodservice Bulk</a>
      </div>

      <div>
        <h2>OEM Services</h2>
        <a href={withBase("/services/")}>Private Label Manufacturing</a>
        <a href={withBase("/services/customization/")}>Custom Packaging</a>
        <a href={withBase("/services/customization/")}>Flavor Development</a>
        <a href={withBase("/services/")}>Export Support</a>
      </div>

      <div>
        <h2>Company</h2>
        <a href={withBase("/company/")}>About us</a>
        <a href={withBase("/factory/production/")}>Manufacturing</a>
        <a href={withBase("/factory/certificates/")}>Quality</a>
        <a href={withBase("/news/")}>News</a>
      </div>

      <div>
        <h2>Contact</h2>
        <a href={withBase("/contact/")}>Start an OEM Project</a>
        <a href={withBase("/contact/")}>Request Samples</a>
        <a href={withBase("/contact/")}>Packaging Consultation</a>
        <a href={withBase("/contact/")}>Export Supply Planning</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Lisheng. All rights reserved.</p>
    <div>
      <a href={withBase("/privacy/")}>Privacy Policy</a>
      <a href={withBase("/terms/")}>Terms</a>
      <a href={withBase("/contact/")}>Contact</a>
    </div>
  </div>
</footer>
