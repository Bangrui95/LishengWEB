---
import { withBase } from "../lib/url";
import { getUI, localizeHref, type Lang } from "../lib/i18n";
import ContactCta from "./ContactCta.astro";
import "../styles/footer.css";

interface Props {
  showCta?: boolean;
  lang?: Lang;
}
const { showCta = true, lang = "en" } = Astro.props;
const ui = getUI(lang);
const f = ui.footer;
const nav = ui.nav;
const localize = (href: string) => localizeHref(href, lang);
---

{showCta && (
  <ContactCta
    kicker={ui.cta.kicker}
    title={ui.cta.title}
    text={ui.cta.text}
    buttonLabel={ui.cta.button}
    secondaryLabel={ui.cta.secondary}
    secondaryHref="/services/customization/"
  />
)}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={withBase("/images/icon/logo-white.webp")} alt="Lisheng logo" />
      <p>{f.desc}</p>
      <a class="footer-quote" href={withBase("/contact/")}>{ui.quote}</a>

      {/* Social links — platforms not ready yet, all point to Contact for now; swap in real account URLs later */}
      <div class="footer-social" aria-label="Social media">
        <a href={withBase(localize("/contact/"))} aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
        </a>
        <a href={withBase(localize("/contact/"))} aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={withBase(localize("/contact/"))} aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
        </a>
        <a href={withBase(localize("/contact/"))} aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        <a href={withBase(localize("/contact/"))} aria-label="Alibaba.com">
          <svg viewBox="-2 157 644 326" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M372.5,160.0 400.0,159.5 417.0,161.5 435.0,165.5 465.0,177.5 474.0,183.5 487.5,197.0 495.5,211.0 499.5,227.0 497.5,249.0 484.5,277.0 445.5,333.0 390.5,398.0 378.5,418.0 377.5,425.0 381.0,431.5 394.0,434.5 450.0,428.5 479.0,423.5 521.0,412.5 634.5,376.0 570.0,409.5 533.0,426.5 496.0,441.5 451.0,456.5 401.0,468.5 379.0,470.5 346.0,468.5 333.0,462.5 326.5,454.0 324.5,442.0 327.5,431.0 338.5,408.0 358.5,380.0 429.5,299.0 456.5,260.0 465.5,240.0 462.5,225.0 453.0,215.5 421.0,201.5 374.0,185.5 363.5,190.0 382.0,208.5 321.0,219.5 267.0,232.5 218.0,246.5 168.0,263.5 166.5,267.0 172.5,280.0 171.5,289.0 167.5,296.0 150.0,309.5 143.0,318.5 173.0,324.5 197.0,324.5 220.0,320.5 238.0,314.5 266.0,299.5 266.5,297.0 261.0,288.5 274.0,293.5 281.5,301.0 284.5,309.0 283.5,318.0 282.0,319.5 275.5,313.0 273.0,306.5 261.0,314.5 236.0,326.5 202.0,335.5 160.0,336.5 124.0,329.5 123.5,363.0 121.5,367.0 90.0,387.5 71.0,402.5 63.5,411.0 59.5,423.0 63.5,436.0 73.0,444.5 91.0,451.5 114.0,455.5 143.0,455.5 239.0,441.5 244.0,442.5 219.0,453.5 181.0,466.5 146.0,474.5 104.0,479.5 78.0,479.5 53.0,475.5 28.0,465.5 13.5,454.0 4.5,441.0 -0.5,423.0 0.5,402.0 8.5,376.0 21.5,351.0 40.5,325.0 54.5,309.0 102.0,263.5 128.0,243.5 164.0,220.5 220.0,193.5 254.0,181.5 296.0,170.5 343.0,162.5 372.5,160.0Z"/></svg>
        </a>
        <a href={withBase(localize("/contact/"))} aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <h2>{f.company}</h2>
        <a href={withBase(localize("/company/"))}>{f.about}</a>
        <a href={withBase(localize("/company/honors/"))}>{nav.honors}</a>
        <a href={withBase(localize("/company/subsidiaries/"))}>{nav.subsidiaries}</a>
      </div>

      <div>
        <h2>{f.factory}</h2>
        <a href={withBase(localize("/factory/production/"))}>{nav.smartFactory}</a>
        <a href={withBase(localize("/factory/lab/"))}>{nav.foodLab}</a>
        <a href={withBase(localize("/factory/certificates/"))}>{f.certifications}</a>
      </div>

      <div>
        <h2>{f.services}</h2>
        <a href={withBase(localize("/services/"))}>{f.oemShort}</a>
        <a href={withBase(localize("/services/customization/"))}>{nav.customization}</a>
      </div>

      <div>
        <h2>{f.products}</h2>
        <a href={withBase(localize("/products/"))}>{f.allProducts}</a>
        <a href={withBase(localize("/products/specifications/"))}>{f.specifications}</a>
      </div>

      <div>
        <h2>{f.contact}</h2>
        <a href={withBase(localize("/contact/"))}>{f.startProject}</a>
        <a href={withBase(localize("/contact/"))}>{f.requestSamples}</a>
      </div>

      <div>
        <h2>{f.news}</h2>
        <a href={withBase(localize("/news/"))}>{f.latestNews}</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>{f.rights}</p>
    <div>
      {/* Privacy / Terms pages not built yet — render as non-clickable text */}
      <span class="footer-disabled">{f.privacy}</span>
      <span class="footer-disabled">{f.terms}</span>
      <a href={withBase("/contact/")}>{f.contact}</a>
    </div>
  </div>
</footer>
