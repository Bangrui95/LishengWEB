---
import { withBase } from "../lib/url";
import { getUI, type Lang } from "../lib/i18n";
import "../styles/header.css";

// `lang` selects the label set; `langAltHref` is the same page in the other
// language (when omitted the switcher stays a placeholder).
interface Props {
  lang?: Lang;
  langAltHref?: string;
}
const { lang = "en", langAltHref } = Astro.props;
const t = getUI(lang).nav;
const ui = getUI(lang);

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: t.home },
  {
    href: "/company/",
    label: t.company,
    children: [
      { href: "/company/", label: t.about },
      { href: "/company/honors/", label: t.honors },
      { href: "/company/subsidiaries/", label: t.subsidiaries }
    ]
  },
  {
    href: "/factory/production/",
    label: t.factory,
    children: [
      { href: "/factory/production/", label: t.smartFactory },
      { href: "/factory/lab/", label: t.foodLab },
      { href: "/factory/certificates/", label: t.certifications },
      { href: "/factory/tour/", label: t.factoryTour }
    ]
  },
  {
    href: "/services/",
    label: t.services,
    children: [
      { href: "/services/", label: t.oem },
      { href: "/services/customization/", label: t.customization }
    ]
  },
  {
    href: "/products/",
    label: t.products,
    children: [
      { href: "/products/#noodles", label: t.noodleProducts },
      { href: "/products/#flour", label: t.flourProducts },
      { href: "/products/#customization", label: t.partner },
      { href: "/products/specifications/", label: t.specifications }
    ]
  },
  { href: "/news/", label: t.news },
  { href: "/contact/", label: t.contact }
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

const isExactActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath === href.replace(/\/$/, "");
};

// Company and Factory share the /company/ path prefix, so dropdown parents
// highlight only when one of their own pages is open.
const navActive = (item: { href: string; children?: { href: string }[] }) =>
  item.children
    ? [item.href, ...item.children.map((c) => c.href.split("#")[0])].some(
        isExactActive
      )
    : isActive(item.href);
---

<header class="site-header" data-header>
  <a class="site-logo" href={withBase("/")} aria-label="Home">
    <img src={withBase("/images/icon/logo-white.png")} alt="Lisheng logo" />
  </a>

  <button class="nav-toggle" type="button" data-nav-toggle aria-label="Open navigation">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" data-site-nav>
    {navItems.map((item) =>
      item.children ? (
        <div class={`nav-item has-dropdown ${navActive(item) ? "active" : ""}`}>
          <a
            href={withBase(item.href)}
            class={navActive(item) ? "active" : ""}
            aria-haspopup="true"
          >
            {item.label}
            <span class="nav-chevron" aria-hidden="true"></span>
          </a>
          <div class="nav-dropdown" aria-label={`${item.label} sections`}>
            {item.children.map((child) => (
              <a
                href={withBase(child.href)}
                class={isExactActive(child.href) ? "active" : ""}
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a href={withBase(item.href)} class={isActive(item.href) ? "active" : ""}>
          {item.label}
        </a>
      )
    )}
  </nav>

  <a class="quote-link" href={withBase("/contact/")}>{ui.quote}</a>

  <div class="nav-item has-dropdown lang-switch">
    <a href="#" aria-haspopup="true" aria-label="Language">{ui.langCurrent}</a>
    <div class="nav-dropdown" aria-label="Languages">
      <a href={langAltHref ? withBase(langAltHref) : "#"}>{ui.langOther}</a>
    </div>
  </div>
</header>
