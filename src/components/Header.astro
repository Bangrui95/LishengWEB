---
import { withBase } from "../lib/url";
import {
  getUI,
  localizeHref,
  languageAlternates,
  langLabels,
  type Lang,
} from "../lib/i18n";
import "../styles/header.css";

// `lang` selects the label set. The language switcher is derived automatically
// from the current path, so every language sees all the others. (`langAltHref`
// is accepted for backward compatibility with older pages but is unused.)
interface Props {
  lang?: Lang;
  langAltHref?: string;
}
const { lang = "en" } = Astro.props;
const t = getUI(lang).nav;
const ui = getUI(lang);

// Nav links point at /zh/... on Chinese pages for routes that have a zh
// version (see `zhReady` in lib/i18n.ts); everything else stays English.
const localize = (href: string) => localizeHref(href, lang);

// Astro.url.pathname includes the configured base (e.g. /LishengWEB/...), but
// nav hrefs and the language routes are base-less — strip it so active-state
// matching and the language switcher compare like for like.
const BASE = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const currentPath =
  BASE !== "/" && rawPath.startsWith(BASE)
    ? "/" + rawPath.slice(BASE.length)
    : BASE !== "/" && rawPath === BASE.replace(/\/$/, "")
      ? "/"
      : rawPath;
const langAlts = languageAlternates(currentPath);
const navItems = [
  { href: localize("/"), label: t.home },
  {
    href: localize("/company/"),
    label: t.company,
    children: [
      { href: localize("/company/"), label: t.about },
      { href: localize("/company/honors/"), label: t.honors },
      { href: localize("/company/subsidiaries/"), label: t.subsidiaries }
    ]
  },
  {
    href: localize("/factory/production/"),
    label: t.factory,
    children: [
      { href: localize("/factory/production/"), label: t.smartFactory },
      { href: localize("/factory/lab/"), label: t.foodLab },
      { href: localize("/factory/certificates/"), label: t.certifications }
    ]
  },
  {
    href: localize("/services/"),
    label: t.services,
    children: [
      { href: localize("/services/"), label: t.oem },
      { href: localize("/services/customization/"), label: t.customization }
    ]
  },
  {
    href: localize("/products/"),
    label: t.products,
    children: [
      { href: localize("/products/"), label: t.ownProducts },
      { href: localize("/products/specifications/"), label: t.specifications }
    ]
  },
  { href: localize("/news/"), label: t.news },
  { href: localize("/contact/"), label: t.contact }
];

// Home / language roots ("/", "/zh/", "/ru/") must match exactly — otherwise
// the localized home link ("/ru/") prefixes every page under that language and
// would stay highlighted everywhere. Other leaves match by prefix as usual.
const isRoot = (href: string) => href === "/" || /^\/[a-z]{2}\/$/.test(href);
const isActive = (href: string) => {
  if (isRoot(href)) {
    return currentPath === href || currentPath === href.replace(/\/$/, "");
  }
  return currentPath.startsWith(href);
};

const isExactActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath === href.replace(/\/$/, "");
};

// Company and Factory share the /company/ path prefix, so dropdown parents
// highlight only when one of their own pages is open.
const navActive = (item: { href: string; children?: { href: string }[] }) =>
  item.children
    ? [item.href, ...item.children.map((c) => c.href.split("#")[0])].some(
        isExactActive
      )
    : isActive(item.href);
---

<header class="site-header" data-header>
  <a class="site-logo" href={withBase(localize("/"))} aria-label="Home">
    <img src={withBase("/images/icon/logo-white.webp")} alt="Lisheng logo" />
  </a>

  <button class="nav-toggle" type="button" data-nav-toggle aria-label="Open navigation">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" data-site-nav>
    {navItems.map((item) =>
      item.children ? (
        <div class={`nav-item has-dropdown ${navActive(item) ? "active" : ""}`}>
          <a
            href={withBase(item.href)}
            class={navActive(item) ? "active" : ""}
            aria-haspopup="true"
          >
            {item.label}
            <span class="nav-chevron" aria-hidden="true"></span>
          </a>
          <div class="nav-dropdown" aria-label={`${item.label} sections`}>
            {item.children.map((child) => (
              <a
                href={withBase(child.href)}
                class={isExactActive(child.href) ? "active" : ""}
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a href={withBase(item.href)} class={isActive(item.href) ? "active" : ""}>
          {item.label}
        </a>
      )
    )}
  </nav>

  <a class="quote-link" href={withBase(localize("/contact/"))}>{ui.quote}</a>

  <div class="nav-item has-dropdown lang-switch">
    <a href="#" aria-haspopup="true" aria-label="Language">{langLabels[lang]}</a>
    <div class="nav-dropdown" aria-label="Languages">
      {langAlts
        .filter((alt) => !alt.current)
        .map((alt) => (
          <a href={withBase(alt.href)} hreflang={alt.code}>{alt.label}</a>
        ))}
    </div>
  </div>
</header>
