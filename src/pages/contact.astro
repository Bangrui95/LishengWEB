---
import { withBase } from "../lib/url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import "../styles/contact.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>Request a Quote | Lisheng International</title>
    <meta
      name="description"
      content="Contact Lisheng for OEM noodle manufacturing, private label production, custom packaging, samples, and export-ready supply support."
    />
  </head>
  <body class="quote-page">
    <Header langAltHref="/zh/contact/" />

    <main>
      <section class="quote-hero" aria-labelledby="quote-hero-title">
        <div class="quote-hero-inner">
          <div class="quote-hero-text">
            <p class="quote-kicker">Request a Quote</p>
            <h1 id="quote-hero-title">
              Start your <span>private label noodle project</span> with Lisheng
            </h1>
            <div class="quote-hero-actions">
              <a href={withBase("/services/customization/")} class="quote-primary">Product Customization</a>
              <a href="#quote-form" class="quote-secondary">Send an Inquiry</a>
            </div>
          </div>
        </div>
      </section>

      <section id="quote-process" class="quote-process" aria-labelledby="quote-process-title">
        <div class="quote-section-heading">
          <p>From inquiry to production</p>
          <h2 id="quote-process-title">A straightforward private label workflow.</h2>
        </div>

        <ol class="quote-process-list">
          <li>
            <span>01</span>
            <h3>Share Requirements</h3>
            <p>Send your product direction, target market, packaging idea, and timeline.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Confirm Samples</h3>
            <p>We align formula, texture, flavor, packaging, and specification details.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Receive Quote</h3>
            <p>Get a proposal based on product scope, MOQ, packaging, and export needs.</p>
          </li>
          <li>
            <span>04</span>
            <h3>Plan Production</h3>
            <p>Move into artwork, production schedule, quality checks, and shipment planning.</p>
          </li>
        </ol>
      </section>

      <section class="quote-form-section" aria-labelledby="quote-form-title">
        <div class="quote-form-intro">
          <p>Inquiry Form</p>
          <h2 id="quote-form-title">Tell us about your noodle project.</h2>
          <span>
            Fields marked with * help us prepare a clearer, faster proposal.
          </span>
        </div>

        <div class="quote-form-layout">
          <form
            id="quote-form"
            class="quote-form"
            action="/api/submit"
            method="post"
            data-lang="en"
            data-msg-sending="Sending your inquiry…"
            data-msg-success="Thank you — your inquiry has been received. Our team will get back to you shortly."
            data-msg-error="Sorry, we couldn't send your inquiry. Please try again, or email us directly at lishengnoodles@gmail.com."
          >
            <input type="hidden" name="customization" data-customization-input />
            <div class="hp-field" aria-hidden="true">
              <label
                >Leave this field empty
                <input type="text" name="lisheng_hp" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="form-grid">
              <label>
                First name*
                <input type="text" name="first-name" autocomplete="given-name" required />
              </label>

              <label>
                Last name*
                <input type="text" name="last-name" autocomplete="family-name" required />
              </label>

              <label>
                Business email*
                <input type="email" name="email" autocomplete="email" required />
              </label>

              <label>
                Phone / WhatsApp
                <input type="tel" name="phone" autocomplete="tel" />
              </label>

              <label>
                Company*
                <input type="text" name="company" autocomplete="organization" required />
              </label>

              <label>
                Country / Market*
                <input type="text" name="country" autocomplete="country-name" required />
              </label>

              <label>
                Product category*
                <select name="product-category" required>
                  <option value="">Select a product category</option>
                  <option>Dry noodles</option>
                  <option>Ramen noodles</option>
                  <option>Foodservice bulk noodles</option>
                  <option>Custom OEM product</option>
                </select>
              </label>

              <label>
                Estimated order volume
                <select name="order-volume">
                  <option value="">Select estimated volume</option>
                  <option>Trial order / sampling stage</option>
                  <option>One container</option>
                  <option>Monthly container supply</option>
                  <option>Distributor program</option>
                  <option>Not sure yet</option>
                </select>
              </label>

              <div class="form-customization form-wide" data-customization-block>
                <h3>Product Customization Details</h3>
                <div class="form-customization-row">
                  <div class="form-customization-display">
                    <span class="form-customization-empty"
                      >No customization saved yet</span
                    >
                    <span class="form-customization-saved"
                      >Customization saved</span
                    >
                  </div>
                  <div class="form-customization-actions">
                    <a
                      class="form-customization-button"
                      href={withBase("/services/customization/")}
                    >
                      <span class="form-customization-cta-empty">Customize</span>
                      <span class="form-customization-cta-filled">Edit</span>
                    </a>
                    <button
                      type="button"
                      class="form-customization-reset"
                      data-customization-reset
                      aria-label="Clear saved customization"
                    >
                      <span aria-hidden="true">✕</span>
                    </button>
                  </div>
                </div>
                <p class="form-customization-note">
                  Prefer to define your product in more detail first? Use Product
                  Customization to specify noodle type, formulation, packaging
                  format and certification needs step by step — your selection is
                  sent to us together with this inquiry.
                </p>
              </div>

              <label class="form-wide customization-details-field">
                Customization Details
                <textarea
                  name="customization-details"
                  class="customization-details"
                  data-customization-details
                  readonly
                  placeholder="Use the Customize button above to build your product spec — your selections will appear here."
                ></textarea>
              </label>

              <label class="form-wide">
                Your message*
                <textarea
                  name="message"
                  required
                  placeholder="Tell us about your target market, flavor direction, packaging idea, certifications, and timeline."
                ></textarea>
              </label>
            </div>

            <label class="quote-check">
              <input type="checkbox" name="updates" />
              <span>I would like to receive product and OEM manufacturing updates.</span>
            </label>

            <div class="quote-form-footer">
              <button type="submit">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M21 3 10.8 13.2" />
                  <path d="m21 3-6.5 18-3.7-7.8L3 9.5 21 3Z" />
                </svg>
                Submit Inquiry
              </button>
              <p>
                By submitting this form, you agree that Lisheng may contact you
                about your inquiry. Fields with * are mandatory.
              </p>
              <p class="quote-form-status" data-form-status role="status" aria-live="polite" hidden></p>
            </div>
          </form>

          <aside class="quote-side-panel" aria-label="Inquiry support details">
            <h2>What happens next?</h2>
            <ul>
              <li>
                <span>1</span>
                <p>We review your product type, market, packaging, and target volume.</p>
              </li>
              <li>
                <span>2</span>
                <p>Our team confirms feasibility, sample direction, and key specifications.</p>
              </li>
              <li>
                <span>3</span>
                <p>You receive a practical quotation path for OEM production.</p>
              </li>
            </ul>
            <div class="quote-side-card">
              <p>For clear quotation, prepare:</p>
              <strong>Product type, pack size, market, quantity, and certification needs.</strong>
            </div>
          </aside>
        </div>
      </section>

      <section class="quote-contact" aria-labelledby="quote-contact-title">
        <div class="quote-section-heading">
          <p>Get in touch</p>
          <h2 id="quote-contact-title">Contact information.</h2>
        </div>

        <div class="quote-contact-grid">
          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <h3>Address</h3>
            <p>No.5, National Road 327, Liuhang, Jining High-tech Industrial Development Zone, Shandong, China</p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </span>
            <h3>Telephone</h3>
            <p><a href="tel:+865373206996">+86 537-3206996</a></p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
            </span>
            <h3>E-mail</h3>
            <p><a href="mailto:lsjt2000@126.com">lsjt2000@126.com</a></p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
              </svg>
            </span>
            <h3>LinkedIn</h3>
            <p><a href="#" target="_blank" rel="noopener">Lisheng Group</a></p>
          </article>
        </div>
      </section>

    </main>

    <Footer showCta={false} />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>
    <script is:inline src={withBase("/scripts/inquiry.js")} defer></script>

    <script>
      // Product customization status row.
      // If the visitor arrives from the Product Customization page (or a saved
      // selection already exists), show the "recorded" confirmation instead of
      // the empty hint — without revealing the stored details.
      // NOTE: the actual storage/transfer of selections is wired up later;
      // for now we detect a URL flag or a sessionStorage marker.
      (function () {
        const block = document.querySelector("[data-customization-block]");
        if (!block) return;
        const hidden = document.querySelector("[data-customization-input]");
        const detailsEl = document.querySelector("[data-customization-details]");

        // One line per step: "Product Type: Udon Style / Ramen Style".
        function formatSelections(sel) {
          return Object.keys(sel)
            .map((k) => k + ": " + sel[k].join(" / "))
            .join("\n");
        }

        // Reflect saved customization (if any) from sessionStorage: the status
        // box shows "saved", the full selection is listed line by line in the
        // details field, and the raw object rides along in the hidden field so
        // it ships with the form once the backend is wired.
        let selections = null;
        try {
          const raw = sessionStorage.getItem("lisheng-customization");
          if (raw) selections = JSON.parse(raw);
        } catch (e) {}
        const filled = selections && Object.keys(selections).length > 0;

        block.dataset.customizationBlock = filled ? "filled" : "";
        if (hidden) hidden.value = filled ? JSON.stringify(selections) : "";
        if (detailsEl)
          detailsEl.value = filled ? formatSelections(selections) : "";

        // When something is saved the button is "Edit": send a flag so the
        // customization page restores the saved picks instead of clearing.
        if (filled) {
          const editBtn = block.querySelector(".form-customization-button");
          if (editBtn) {
            const base = editBtn.getAttribute("href");
            editBtn.setAttribute(
              "href",
              base + (base.indexOf("?") === -1 ? "?" : "&") + "edit=1"
            );
          }
        }

        // Reset: clear the saved customization on this page (storage + fields)
        // and revert the status box to "not saved".
        const resetBtn = block.querySelector("[data-customization-reset]");
        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            sessionStorage.removeItem("lisheng-customization");
            sessionStorage.removeItem("lisheng-customization-types");
            block.dataset.customizationBlock = "";
            if (hidden) hidden.value = "";
            if (detailsEl) detailsEl.value = "";
          });
        }
      })();
    </script>
  </body>
</html>
