---
import { withBase } from "../../lib/url";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import "../../styles/global.css";
import "../../styles/contact.css";
import "../../styles/ru.css";
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>Запросить расчёт | Lisheng International</title>
    <meta
      name="description"
      content="Свяжитесь с Lisheng по вопросам OEM-производства лапши, выпуска под частной маркой, индивидуальной упаковки, образцов и готовых к экспорту поставок."
    />
  </head>
  <body class="quote-page">
    <Header lang="ru" />

    <main>
      <section class="quote-hero" aria-labelledby="quote-hero-title">
        <div class="quote-hero-inner">
          <div class="quote-hero-text">
            <p class="quote-kicker">Запросить расчёт</p>
            <h1 id="quote-hero-title">
              Запустите <span>проект лапши под частной маркой</span> с Lisheng
            </h1>
            <div class="quote-hero-actions">
              <a href={withBase("/ru/services/customization/")} class="quote-primary">Индивидуальная разработка</a>
              <a href="#quote-form" class="quote-secondary">Отправить запрос</a>
            </div>
          </div>
        </div>
      </section>

      <section id="quote-process" class="quote-process" aria-labelledby="quote-process-title">
        <div class="quote-section-heading">
          <p>От запроса до производства</p>
          <h2 id="quote-process-title">Понятный процесс работы под частной маркой.</h2>
        </div>

        <ol class="quote-process-list">
          <li>
            <span>01</span>
            <h3>Поделитесь требованиями</h3>
            <p>Пришлите направление продукта, целевой рынок, идею упаковки и сроки.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Согласуйте образцы</h3>
            <p>Мы согласуем рецептуру, текстуру, вкус, упаковку и детали спецификации.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Получите расчёт</h3>
            <p>Получите предложение на основе объёма продукта, MOQ, упаковки и экспортных потребностей.</p>
          </li>
          <li>
            <span>04</span>
            <h3>Спланируйте производство</h3>
            <p>Переходите к макетам, графику производства, контролю качества и планированию отгрузки.</p>
          </li>
        </ol>
      </section>

      <section class="quote-form-section" aria-labelledby="quote-form-title">
        <div class="quote-form-intro">
          <p>Форма запроса</p>
          <h2 id="quote-form-title">Расскажите о вашем проекте по лапше.</h2>
          <span>
            Поля, отмеченные *, помогают нам быстрее подготовить точное предложение.
          </span>
        </div>

        <div class="quote-form-layout">
          <form id="quote-form" class="quote-form" action="#" method="post">
            <input type="hidden" name="customization" data-customization-input />

            <div class="form-grid">
              <label>
                Имя*
                <input type="text" name="first-name" autocomplete="given-name" required />
              </label>

              <label>
                Фамилия*
                <input type="text" name="last-name" autocomplete="family-name" required />
              </label>

              <label>
                Рабочий e-mail*
                <input type="email" name="email" autocomplete="email" required />
              </label>

              <label>
                Телефон / WhatsApp
                <input type="tel" name="phone" autocomplete="tel" />
              </label>

              <label>
                Компания*
                <input type="text" name="company" autocomplete="organization" required />
              </label>

              <label>
                Страна / рынок*
                <input type="text" name="country" autocomplete="country-name" required />
              </label>

              <label>
                Категория продукта*
                <select name="product-category" required>
                  <option value="">Выберите категорию продукта</option>
                  <option>Сухая лапша</option>
                  <option>Лапша рамэн</option>
                  <option>Оптовая лапша для HoReCa</option>
                  <option>Индивидуальный OEM-продукт</option>
                </select>
              </label>

              <label>
                Предполагаемый объём заказа
                <select name="order-volume">
                  <option value="">Выберите объём</option>
                  <option>Пробный заказ / стадия образцов</option>
                  <option>Один контейнер</option>
                  <option>Ежемесячная поставка контейнерами</option>
                  <option>Дистрибьюторская программа</option>
                  <option>Пока не уверен</option>
                </select>
              </label>

              <div class="form-customization form-wide" data-customization-block>
                <h3>Детали индивидуальной разработки</h3>
                <div class="form-customization-row">
                  <div class="form-customization-display">
                    <span class="form-customization-empty"
                      >Конфигурация ещё не сохранена</span
                    >
                    <span class="form-customization-saved"
                      >Конфигурация сохранена</span
                    >
                  </div>
                  <div class="form-customization-actions">
                    <a
                      class="form-customization-button"
                      href={withBase("/ru/services/customization/")}
                    >
                      <span class="form-customization-cta-empty">Настроить</span>
                      <span class="form-customization-cta-filled">Изменить</span>
                    </a>
                    <button
                      type="button"
                      class="form-customization-reset"
                      data-customization-reset
                      aria-label="Очистить сохранённую конфигурацию"
                    >
                      <span aria-hidden="true">✕</span>
                    </button>
                  </div>
                </div>
                <p class="form-customization-note">
                  Хотите сначала описать продукт подробнее? В разделе
                  «Индивидуальная разработка» шаг за шагом укажите тип лапши,
                  рецептуру, формат упаковки и требования к сертификации — ваш
                  выбор отправится нам вместе с этим запросом.
                </p>
              </div>

              <label class="form-wide customization-details-field">
                Детали конфигурации
                <textarea
                  name="customization-details"
                  class="customization-details"
                  data-customization-details
                  readonly
                  placeholder="Нажмите кнопку «Настроить» выше, чтобы собрать спецификацию продукта — ваш выбор появится здесь."
                ></textarea>
              </label>

              <label class="form-wide">
                Ваше сообщение*
                <textarea
                  name="message"
                  required
                  placeholder="Расскажите о целевом рынке, вкусовом направлении, идее упаковки, сертификации и сроках."
                ></textarea>
              </label>
            </div>

            <label class="quote-check">
              <input type="checkbox" name="updates" />
              <span>Я хочу получать новости о продуктах и OEM-производстве.</span>
            </label>

            <div class="quote-form-footer">
              <button type="submit">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M21 3 10.8 13.2" />
                  <path d="m21 3-6.5 18-3.7-7.8L3 9.5 21 3Z" />
                </svg>
                Отправить запрос
              </button>
              <p>
                Отправляя форму, вы соглашаетесь, что Lisheng может связаться с
                вами по вашему запросу. Поля с * обязательны.
              </p>
            </div>
          </form>

          <aside class="quote-side-panel" aria-label="Сопровождение запроса">
            <h2>Что дальше?</h2>
            <ul>
              <li>
                <span>1</span>
                <p>Мы изучаем тип продукта, рынок, упаковку и целевой объём.</p>
              </li>
              <li>
                <span>2</span>
                <p>Наша команда подтверждает осуществимость, направление образцов и ключевые спецификации.</p>
              </li>
              <li>
                <span>3</span>
                <p>Вы получаете практичный маршрут расчёта для OEM-производства.</p>
              </li>
            </ul>
            <div class="quote-side-card">
              <p>Для точного расчёта подготовьте:</p>
              <strong>Тип продукта, размер упаковки, рынок, количество и требования к сертификации.</strong>
            </div>
          </aside>
        </div>
      </section>

      <section class="quote-contact" aria-labelledby="quote-contact-title">
        <div class="quote-section-heading">
          <p>Свяжитесь с нами</p>
          <h2 id="quote-contact-title">Контактная информация.</h2>
        </div>

        <div class="quote-contact-grid">
          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <h3>Адрес</h3>
            <p>Китай, провинция Шаньдун, г. Цзинин, зона высоких технологий, Люхан, Национальная дорога 327, № 5</p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </span>
            <h3>Телефон</h3>
            <p><a href="tel:+865373206996">+86 537-3206996</a></p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
            </span>
            <h3>E-mail</h3>
            <p><a href="mailto:lsjt2000@126.com">lsjt2000@126.com</a></p>
          </article>

          <article class="quote-contact-card">
            <span class="quote-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
              </svg>
            </span>
            <h3>LinkedIn</h3>
            <p><a href="#" target="_blank" rel="noopener">Lisheng Group</a></p>
          </article>
        </div>
      </section>

    </main>

    <Footer showCta={false} lang="ru" />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>

    <script>
      // Product customization status row.
      // If the visitor arrives from the Product Customization page (or a saved
      // selection already exists), show the "recorded" confirmation instead of
      // the empty hint — without revealing the stored details.
      // NOTE: the actual storage/transfer of selections is wired up later;
      // for now we detect a URL flag or a sessionStorage marker.
      (function () {
        const block = document.querySelector("[data-customization-block]");
        if (!block) return;
        const hidden = document.querySelector("[data-customization-input]");
        const detailsEl = document.querySelector("[data-customization-details]");

        // One line per step: "Product Type: Udon Style / Ramen Style".
        function formatSelections(sel) {
          return Object.keys(sel)
            .map((k) => k + ": " + sel[k].join(" / "))
            .join("\n");
        }

        // Reflect saved customization (if any) from sessionStorage: the status
        // box shows "saved", the full selection is listed line by line in the
        // details field, and the raw object rides along in the hidden field so
        // it ships with the form once the backend is wired.
        let selections = null;
        try {
          const raw = sessionStorage.getItem("lisheng-customization");
          if (raw) selections = JSON.parse(raw);
        } catch (e) {}
        const filled = selections && Object.keys(selections).length > 0;

        block.dataset.customizationBlock = filled ? "filled" : "";
        if (hidden) hidden.value = filled ? JSON.stringify(selections) : "";
        if (detailsEl)
          detailsEl.value = filled ? formatSelections(selections) : "";

        // When something is saved the button is "Edit": send a flag so the
        // customization page restores the saved picks instead of clearing.
        if (filled) {
          const editBtn = block.querySelector(".form-customization-button");
          if (editBtn) {
            const base = editBtn.getAttribute("href");
            editBtn.setAttribute(
              "href",
              base + (base.indexOf("?") === -1 ? "?" : "&") + "edit=1"
            );
          }
        }

        // Reset: clear the saved customization on this page (storage + fields)
        // and revert the status box to "not saved".
        const resetBtn = block.querySelector("[data-customization-reset]");
        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            sessionStorage.removeItem("lisheng-customization");
            sessionStorage.removeItem("lisheng-customization-types");
            block.dataset.customizationBlock = "";
            if (hidden) hidden.value = "";
            if (detailsEl) detailsEl.value = "";
          });
        }
      })();
    </script>
  </body>
</html>
