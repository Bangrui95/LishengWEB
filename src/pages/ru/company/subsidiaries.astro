---
import Seo from "../../../components/Seo.astro";
import { withBase } from "../../../lib/url";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import "../../../styles/global.css";
import "../../../styles/subpage.css";
import "../../../styles/company-subsidiaries.css";
import "../../../styles/ru.css";

// One entry per subsidiary — swap the placeholder images later.
const subsidiaries = [
  {
    name: "Shandong Lisheng Food Group Co., Ltd.",
    year: "1995",
    kicker: "Головной офис · Цзинин",
    image: "/images/company/subsidiaries/jining-hq.webp",
    facts: ["Цзинин, Шаньдун", "450+ сотрудников", "1 100 т пшеницы/сутки", "200 т лапши/сутки"],
    copy: "Головное предприятие и место основания группы, расположенное в Люхане, в зоне высоких технологий города Цзинин. Штат насчитывает более 450 сотрудников, включая большую команду инженеров и управленцев; ежесуточно перерабатывается 1 100 тонн пшеницы, выпускается 200 тонн сухой лапши и 200 тонн риса на оборудовании Bühler с контрольными приборами Perten. Три продуктовые серии охватывают более 60 наименований, которые поставляются в 300+ городов в 30 провинциях. Завод сертифицирован по ISO 9001, ISO 14001 и ISO 22000, имеет национальные статусы «Надёжное зерно и масло» и «Экологически чистая сельхозпродукция», а в ноябре 2011 года торговая марка «Lisheng» была признана «Известной торговой маркой Китая».",
  },
  {
    name: "Shandong Lisheng Group Wenshang Flour Co., Ltd.",
    year: "2005",
    kicker: "Производственная база · Вэньшан",
    image: "/images/company/subsidiaries/wenshang.webp",
    facts: ["Вэньшан, Цзинин", "300+ сотрудников", "1 000 т пшеницы/сутки", "200 т лапши/сутки"],
    copy: "Дочернее предприятие со 100% участием, основанное в 2005 году с уставным капиталом 40 млн юаней, на участке 33 000 м² в зоне элитной пшеницы уезда Вэньшан вблизи национальной автотрассы №105 — рядом с автомобильными, железнодорожными и водными путями. Около 300 сотрудников обслуживают интегрированное мукомольно-макаронное производство, ежесуточно перерабатывая 1 000 тонн пшеницы и выпуская 200 тонн сухой лапши на оборудовании Bühler с приборами Perten; две серии и более 60 наименований поставляются в 260+ городов страны. Предприятие сертифицировано по ISO 9001, ISO 14001 и ISO 22000, а его продукция отмечена титулами «10 ведущих мукомольных брендов Шаньдуна» и «Известный национальный бренд сухой лапши».",
  },
  {
    name: "Shandong Lisheng Group Chengwu Food Co., Ltd.",
    year: "2008",
    kicker: "Производственная база · Чэнъу, Хэцзэ",
    image: "/images/company/subsidiaries/chengwu.webp",
    facts: ["Чэнъу, Шаньдун", "300+ сотрудников", "1 000 т пшеницы/сутки", "200 т лапши/сутки"],
    copy: "Холдинговое дочернее предприятие в посёлке Цзюнюй уезда Чэнъу — национальной зоне защиты производства зерна, с трёх сторон окружённой железными дорогами Пекин–Цзюлун, Жичжао–Хэцзэ и Лунхай. На участке 35 000 м² с совокупными активами 80 млн юаней более 300 сотрудников ежесуточно перерабатывают 1 000 тонн пшеницы и выпускают 200 тонн лапши. Мельница полностью оснащена оборудованием Bühler по технологии, разработанной специалистами Чжэнчжоуского зернового института: пять драных и восемь размольных систем, пять проходов очистки и отбор муки по среднему потоку — мука славится белизной, ароматом и стабильным качеством и поставляется почти в десять северных провинций. На протяжении ряда лет банковская система присваивает предприятию кредитный рейтинг AA.",
  },
  {
    name: "Shandong Lisheng Group Shenzhou Flour Co., Ltd.",
    year: "2009",
    kicker: "Производственная база · Шэньчжоу, Хэбэй",
    image: "/images/company/subsidiaries/shenzhou.webp",
    facts: ["Шэньчжоу, Хэбэй", "600 т пшеницы/сутки", "180 000 т муки/год", "база 170 000 му"],
    copy: "База группы в провинции Хэбэй в промышленном парке Тайгучжуан города Шэньчжоу — ключевой инвестиционный проект города. Коллектив из 68 человек ежесуточно перемалывает 600 тонн пшеницы Северо-Китайской равнины на современных вальцовых станках MDDK и ситовеечных машинах, выпуская до 180 000 тонн муки в год со 100% реализацией в 20+ крупных городах от Пекина до Гуандуна. Именно в Шэньчжоу впервые внедрена модель группы «компания + база + фермер»: пшеничная база площадью 170 000 му работает с 18 000 крестьянских хозяйств в режиме единого снабжения семенами, агросопровождения и закупок — качество зерна обеспечивается ещё до поступления на мельницу.",
  },
  {
    name: "Henan Lisheng Flour Co., Ltd.",
    year: "2016",
    kicker: "Производственная база · Хуасянь, Хэнань",
    image: "/images/company/subsidiaries/henan.webp",
    facts: ["Хуасянь, Хэнань", "100 сотрудников", "20 технических специалистов"],
    copy: "Основано в 2016 году с уставным капиталом 33,6 млн юаней на участке 101 му в новом районе уезда Хуасянь — «первого пшеничного уезда Китая», где ежегодно засевается почти 1,8 млн му пшеницы, собирается около миллиарда килограммов элитного зерна, а урожайность с му удерживает первое место в провинции Хэнань почти три десятилетия. Это ключевой инвестиционный проект уездного правительства; коллектив из 100 человек, включая 20 технических специалистов среднего и высшего звена, расширяет производственную сеть Lisheng в самое сердце пшеничного пояса Хэнани.",
  },
  {
    name: "Liangshan Lisheng Food Co., Ltd.",
    year: "2018",
    kicker: "Флагманский умный завод · Ляншань",
    image: "/images/company/subsidiaries/liangshan.webp",
    facts: ["Ляншань, Шаньдун", "инвестиции 1 млрд юаней", "3 000 т специальной муки/сутки", "1 млн т пшеницы/год"],
    copy: "Дочернее предприятие со 100% участием, основанное в августе 2018 года с уставным капиталом 43 млн юаней, — проект умной зерновой индустрии стоимостью 1 млрд юаней на участке 153 180 м². Четыре интеллектуальные мукомольные линии ежесуточно выпускают 3 000 тонн специальной муки, принимая миллион тонн пшеницы в год под полным управлением PLC и MES — от приёмки пшеницы до паллетирования процесс практически безлюдный. Низкотемпературный помол сохраняет питательную ценность и природный аромат пшеницы, а солнечные панели на крыше площадью 20 000 м² вырабатывают 2 МВт, при этом солнечное тепло обслуживает сушильные камеры лапши. Завод служит опорой стратегии группы по удвоению мощностей и выходу на рынок премиальной специальной муки.",
  },
  {
    name: "Shandong Ruili Food Technology Co., Ltd.",
    year: "2020",
    kicker: "Пищевые технологии · Цзинин",
    image: "/images/company/subsidiaries/ruili.webp",
    facts: ["Цзинин, Шаньдун", "Линия замороженных продуктов", "НИОКР глубокой переработки"],
    copy: "Вошло в состав группы в декабре 2020 года как её подразделение пищевых технологий со штаб-квартирой в Цзинине. Ruili расширяет цепочку в сторону замороженных продуктов и более глубокой переработки, применяя мукомольные и макаронные компетенции Lisheng к продуктам быстрого приготовления нового поколения; линия продаж замороженной продукции уже работает.",
  },
  {
    name: "Jining Tianyu Color Printing & Packaging Co., Ltd.",
    kicker: "Упаковка · Упаковочные мощности группы",
    image: "/images/company/subsidiaries/tianyu.webp",
    facts: ["Цзинин, Шаньдун", "Собственная упаковка", "Поддержка частных марок"],
    copy: "Собственная упаковочная компания группы в Цзинине, выпускающая плёночную и картонную упаковку для продукции Lisheng и OEM-проектов. Размещение дизайна и производства упаковки внутри группы и делает возможными гибкие форматы частных марок, мелкосерийную смену макетов и быстрые сроки изготовления упаковки для экспортных клиентов.",
  },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>Дочерние компании | Lisheng International</title>
    <meta
      name="description"
      content="Восемь дочерних компаний Shandong Lisheng Group: мукомольные и макаронные производственные базы в Шаньдуне, Хэбэе и Хэнани, а также компании пищевых технологий и упаковки."
    />
    <Seo title={"Дочерние компании | Lisheng International"} description={"Восемь дочерних компаний Shandong Lisheng Group: мукомольные и макаронные производственные базы в Шаньдуне, Хэбэе и Хэнани, а также компании пищевых технологий и упаковки."} />
  </head>
  <body>
    <Header lang="ru" />

    <main>
      <section class="page-hero" aria-labelledby="sub-hero-title">
        <img src={withBase("/images/company/about/lisheng.webp")} alt="Производственные объекты дочерних компаний Lisheng Group" />
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">Структура группы</p>
          <h1 id="sub-hero-title">Дочерние компании</h1>
          <p class="page-hero-copy">
            Восемь компаний в провинциях Шаньдун, Хэбэй и Хэнань —
            производственные базы, пищевые технологии и упаковка в единой
            цепочке поставок.
          </p>
        </div>
      </section>

      <section class="page-section" aria-labelledby="sub-list-title">
        <div class="page-section-inner">
          <p class="company-kicker">Компании группы</p>
          <h2 id="sub-list-title">Одна группа,<br />восемь профильных компаний</h2>
          <p>
            Каждая производственная база расположена в национальном регионе
            элитной пшеницы, а технологическая и упаковочная компании продлевают
            цепочку от зерна до готового к продаже продукта. В совокупности в них
            занято более 1 300 человек, плюс три зерноскладские компании ёмкостью
            200 000 тонн.
          </p>

          <div class="subsidiary-list-block">
            {subsidiaries.map((sub, i) => (
              <article class={`subsidiary-card ${i % 2 === 1 ? "reverse" : ""}`}>
                <div class="subsidiary-media">
                  <img src={withBase(sub.image)} alt={`Производственный объект — ${sub.name}`} />
                </div>
                <div class="subsidiary-copy">
                  {sub.year && <span class="subsidiary-year">{sub.year}</span>}
                  <p class="company-kicker">{sub.kicker}</p>
                  <h3>{sub.name}</h3>
                  <p>{sub.copy}</p>
                  <ul class="subsidiary-facts" aria-label="Ключевые факты">
                    {sub.facts.map((fact) => (
                      <li>{fact}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>

          <div class="company-cta">
            <div>
              <h2>Единый контакт для всей группы</h2>
              <p>
                Какая бы база ни подошла вашему продукту, OEM-запросы ведёт
                единая экспортная команда.
              </p>
            </div>
            <a class="company-cta-link" href={withBase("/ru/contact/")}>
              Запросить расчёт <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang="ru" />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>
  </body>
</html>
