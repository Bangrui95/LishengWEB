---
import { withBase } from "../../lib/url";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import HeroSlider from "../../components/HeroSlider.astro";
import WorldMap from "../../components/WorldMap.astro";
import "../../styles/global.css";
import "../../styles/index.css";
import "../../styles/ru.css";
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>Lisheng International</title>
    <meta
      name="description"
      content="OEM-производство лапши под частной маркой для мировых пищевых брендов, импортёров и дистрибьюторов."
    />
    <meta name="author" content="Bangrui Wang / Design095" />
  </head>
  <body>
    <Header lang="ru" />
    <main>
      <HeroSlider />
      <section class="company-overview" aria-labelledby="company-overview-title">
        <div class="overview-copy">
          <h2 id="company-overview-title">
            Готовое к экспорту производство лапши<br />
            для мировых пищевых брендов
          </h2>
          <p>
            Lisheng обеспечивает зарубежных импортёров, бренды под частной маркой и дистрибьюторов HoReCa индивидуальным производством лапши и муки, собственной упаковочной поддержкой и надёжными поставками для международных рынков.</p>
        </div>

        <div class="overview-stats">
          <div class="stats-row stats-row-primary">
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="30+">
                  <span class="stat-digit" aria-hidden="true">3</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>Лет опыта в пищевом производстве</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="20+">
                  <span class="stat-digit" aria-hidden="true">2</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>Продуктовых линеек и индивидуальное производство</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="6+">
                  <span class="stat-digit" aria-hidden="true">6</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>Экспортных рынков</dd>
            </dl>
          </div>

          <div class="stats-row stats-row-secondary">
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="3">
                  <span class="stat-digit" aria-hidden="true">3</span>
                </span>
                <span class="stat-unit">млрд</span>
              </dt>
              <dd>Годовая выручка</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="7,000">
                  <span class="stat-digit" aria-hidden="true">7</span>
                  <span class="stat-comma" aria-hidden="true">,</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                </span>
                <span class="stat-unit">тонн</span>
              </dt>
              <dd>Суточная переработка пшеницы</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="560">
                  <span class="stat-digit" aria-hidden="true">5</span>
                  <span class="stat-digit" aria-hidden="true">6</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                </span>
                <span class="stat-unit">тонн</span>
              </dt>
              <dd>Суточный выпуск лапши</dd>
            </dl>
          </div>
        </div>
      </section>

      <section class="featured-links" aria-labelledby="featured-links-title">
        <h2 id="featured-links-title" class="sr-only">Избранные ссылки компании</h2>

        <article class="featured-report">
          <div class="report-image">
            <img
              src={withBase("/images/home/oem-noodle-packaging-display.webp")}
              alt="OEM-упаковка лапши и витрина продукции"
            />
          </div>
          <div class="report-copy">
            <h3>Поставки под частной маркой и OEM</h3>
            <p>
              Индивидуальное производство лапши и муки для зарубежных импортёров, розничных брендов и дистрибьюторов HoReCa с поддержкой спецификаций продукта, форматов упаковки и готовых к экспорту поставок.</p>
            <div class="report-actions" aria-label="Ссылки руководства по OEM">
              <a class="report-action" href={withBase("/ru/services/")}>
                <span>Руководство по производству под частной маркой</span>
                <span aria-hidden="true">→</span>
              </a>
              <a class="report-action" href={withBase("/ru/services/customization/")}>
                <span>Индивидуальная разработка продукта</span>
                <span aria-hidden="true">→</span>
              </a>
              <a class="report-action" href={withBase("/ru/contact/")}>
                <span>Запустить проект под частной маркой</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <div class="feature-card-grid">
          <article class="feature-card">
            <img
              src={withBase("/images/home/noodle-manufacturing-company-overview.webp")}
              alt="Обзор производственной компании Lisheng"
            />
            <div class="feature-card-copy">
              <h3>Производственные возможности</h3>
              <p>
                Интегрированная производственная система, охватывающая переработку пшеницы, производство лапши, упаковку и логистику, рассчитанная на стабильное качество, масштабируемый выпуск и долгосрочные поставки.</p>
              <a href={withBase("/ru/company/")}>Узнать больше</a>
            </div>
          </article>

          <article class="feature-card">
            <img
              src={withBase("/images/main/products.webp")}
              alt="Индивидуальные продукты-лапша и услуги"
            />
            <div class="feature-card-copy">
              <h3>Ассортимент продукции</h3>
              <p>
                От лапши до пшеничной муки и упаковки под частной маркой Lisheng разрабатывает продуктовые линейки, адаптируемые для розницы, HoReCa и экспортных каналов. Каждый продукт можно настроить под потребности рынка.</p>
              <a href={withBase("/ru/products/")}>Узнать больше</a>
            </div>
          </article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="about-section-title">
        <div class="about-inner">
          <div class="about-left-panel">
            <div class="about-media">
              <img
                src={withBase("/images/icon/logo.webp")}
                alt="Логотип Lisheng Group"
              />
            </div>

            <div class="subsidiary-list" aria-label="Дочерние компании Lisheng Group">
              <h2>Дочерние компании группы</h2>
              <ul>
                <li>Shandong Lisheng Food Group</li>
                <li>Shandong Lisheng Group Chengwu Food</li>
                <li>Shandong Lisheng Group Wenshang Flour Industry</li>
                <li>Shandong Lisheng Group Shenzhou Flour</li>
                <li>Henan Lisheng Flour Industry</li>
                <li>Liangshan Lisheng Food</li>
                <li>Shandong Ruili Food Technology</li>
                <li>Jining Tianyu Color Printing & Packaging</li>
              </ul>
            </div>
          </div>

          <div class="about-copy">
            <h2 id="about-section-title">О компании</h2>
            <p>
              Shandong Lisheng Group основана в 1995 году и расположена в зоне
              высоких технологий города Цзинин провинции Шаньдун. Группа Lisheng
              неизменно следует корпоративной миссии «создавать дело, которое
              служит повседневной жизни людей». Полностью используя свои
              преимущества в качестве, масштабе, добросовестности, ценности
              бренда и сервисе, группа стремится стать крупным пищевым холдингом
              с яркой индивидуальностью, сильным технологическим потенциалом и
              ключевой конкурентоспособностью.
            </p>
            <p>
              Продукция группы продаётся более чем в 260 крупных и средних
              городах в 30 провинциях, городах центрального подчинения и
              автономных районах Китая. Сухая лапша также экспортируется в
              Юго-Восточную Азию, Европу и на другие международные рынки.
            </p>
            <p>
              Группа располагает шестью мукомольными базами, тремя цехами
              производства сухой лапши и тремя зерноскладскими компаниями.
              Суточная переработка пшеницы составляет 7 000 тонн, суточный выпуск
              сухой лапши — 560 тонн, мощность хранения зерна — 200 000 тонн. Это
              крупное групповое предприятие, объединяющее хранение, переработку,
              продажу и логистику зерна.
            </p>
            <a class="about-more" href={withBase("/ru/company/")}>Узнать больше</a>
          </div>

          <div class="about-rd" aria-labelledby="about-rd-title">
            <div class="about-rd-main">
              <div class="about-rd-copy">
                <p>Исследования и разработка продукции</p>
                <h3 id="about-rd-title">Центр НИОКР</h3>
                <span>
                  Lisheng располагает независимой системой разработки продукции,
                  охватывающей муку, сухую лапшу и сопутствующие продукты на
                  основе зерна. Имея опыт в испытаниях сырья, корректировке
                  рецептур, разработке текстуры лапши и тестировании упаковки,
                  команда поддерживает улучшение продукции под разные рыночные
                  потребности.
                </span>
                <span>
                  Компания также владеет более чем десятью патентами на
                  изобретения в пищевом производстве, что укрепляет её
                  долгосрочный потенциал в инновациях продукции, оптимизации
                  процессов и стабильном промышленном производстве.
                </span>
                <a class="about-more" href={withBase("/ru/factory/lab/")}>Узнать больше</a>
              </div>

              <div
                class="about-rd-media"
                aria-label="Изображения НИОКР и разработки продукции"
              >
                <img
                  src={withBase("/images/home/rd-specialist-checking-noodle-samples.webp")}
                  alt="Специалист НИОКР проверяет образцы лапши"
                />
                <img
                  src={withBase("/images/home/rd-team-product-development.webp")}
                  alt="Команда НИОКР обсуждает детали разработки продукта"
                />
                <img
                  src={withBase("/images/home/noodle-research-sample-testing.webp")}
                  alt="Исследование лапши и испытание образцов"
                />
              </div>

              <dl class="about-rd-points" aria-label="Ключевые возможности НИОКР">
                <div>
                  <dt>Разработка рецептур</dt>
                  <dd>
                    Испытание и корректировка рецептур муки и теста под разные
                    требования к продукту
                  </dd>
                </div>
                <div>
                  <dt>Оптимизация процессов</dt>
                  <dd>
                    Повышение стабильности производства за счёт собственных
                    запатентованных технологий пищевой переработки
                  </dd>
                </div>
                <div>
                  <dt>Стандарты продукции</dt>
                  <dd>
                    Испытано на пищевую безопасность для разных рынков, с
                    поддержкой розничных, HoReCa и экспортных спецификаций
                  </dd>
                </div>
              </dl>
            </div>

            <div class="about-factory" aria-labelledby="about-factory-title">
              <div
                class="about-factory-media"
                aria-label="Изображения заводской переработки и автоматизированного производства"
              >
                <img
                  src={withBase("/images/home/automated-factory-processing-line.webp")}
                  alt="Обзор автоматизированной заводской линии"
                />
                <img
                  src={withBase("/images/home/noodle-processing-machinery.webp")}
                  alt="Оборудование для переработки лапши и производственное оборудование"
                />
                <img
                  src={withBase("/images/home/factory-machining-automated-system.webp")}
                  alt="Заводская обработка и автоматизированная производственная система"
                />
              </div>

              <div class="about-factory-copy">
                <p>ПОЛНЫЙ ЦИКЛ ПРОИЗВОДСТВА</p>
                <h3 id="about-factory-title">
                  Производственная мощь
                </h3>
                <span>
                  Lisheng построила интегрированную систему пищевого
                  производства, охватывающую закупку сырья, мукомольную
                  переработку, производство лапши, упаковку, хранение, логистику
                  и поддержку продаж. Эта полноцепочечная способность позволяет
                  обеспечивать стабильное качество, эффективное производство и
                  надёжные поставки для долгосрочных партнёров.
                </span>
                <span>
                  Под разные рыночные потребности мы поддерживаем индивидуальные
                  спецификации лапши, включая размер продукта, текстуру,
                  рецептуру, формат упаковки и требования к заказу. Имея
                  собственные упаковочные мощности, мы также можем предложить
                  гибкие упаковочные решения для розничных, HoReCa, оптовых
                  продуктов и продуктов под частной маркой.
                </span>
                <a class="about-more" href={withBase("/ru/factory/production/")}>Узнать больше</a>
              </div>

              <dl
                class="about-factory-stats"
                aria-label="Ключевые особенности заводской переработки"
              >
                <div>
                  <dt>Переработка</dt>
                  <dd>
                    Интегрированное производство муки и лапши со стабильным
                    контролем производства
                  </dd>
                </div>
                <div>
                  <dt>Индивидуализация</dt>
                  <dd>
                    Размер, текстура, рецептура лапши и варианты упаковки для
                    разных рынков
                  </dd>
                </div>
                <div>
                  <dt>Упаковка</dt>
                  <dd>
                    Собственная упаковочная поддержка для розничных, HoReCa и
                    private-label продуктов
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <section class="products-section" aria-labelledby="products-section-title">
        <div class="products-inner">
          <div class="section-heading">
            <h2 id="products-section-title">Продукция</h2>
          </div>

          <div
            class="product-tabs"
            role="tablist"
            aria-label="Категории продукции"
          >
            <button
              class="active"
              type="button"
              role="tab"
              aria-selected="true"
              data-product-tab="noodles"
            >
              Лапша
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-product-tab="flour"
            >
              Мука
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-product-tab="customization"
            >
              Индивидуальные решения
            </button>
          </div>

          <div class="product-panels">
            <div class="product-panel active" data-product-panel="noodles">
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/whole-wheat-noodles-500-g.webp")}
                  alt="Серия лапши"
                />
                <h3>Серия лапши</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/whole-wheat-noodles-1-kg.webp")}
                  alt="Упакованная лапша"
                />
                <h3>Упакованная лапша</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/buckwheat-noodles.webp")}
                  alt="Розничный ассортимент лапши"
                />
                <h3>Розничный ассортимент лапши</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/royal-egg-noodles.webp")}
                  alt="Экспортные поставки лапши"
                />
                <h3>Экспортные поставки лапши</h3>
              </article>
            </div>

            <div class="product-panel" data-product-panel="flour" hidden>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/eight-star-strong-gluten-wheat-flour.webp")}
                  alt="Пшеничная мука"
                />
                <h3>Пшеничная мука</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/seven-star-strong-gluten-wheat-flour.webp")}
                  alt="Премиальная мука"
                />
                <h3>Премиальная серия муки</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/six-star-strong-gluten-wheat-flour.webp")}
                  alt="Мука для пищевого производства"
                />
                <h3>Мука для пищевого производства</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/eight-star-snowflake-flour.webp")}
                  alt="Готовая к экспорту упаковка муки"
                />
                <h3>Экспортная упаковка муки</h3>
              </article>
            </div>

            <div class="product-panel" data-product-panel="customization" hidden>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/shanghai-yangchun-noodles.webp")}
                  alt="Кастомизация шанхайской лапши янчунь"
                />
                <h3>Шанхайская лапша янчунь</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/lanzhou-ramen-noodles.webp")}
                  alt="Кастомизация ланьчжоуской ламянь"
                />
                <h3>Ланьчжоуская ламянь</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/sichuan-dandan-noodles.webp")}
                  alt="Кастомизация сычуаньской даньдань"
                />
                <h3>Сычуаньская лапша даньдань</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/shandong-ramen-noodles.webp")}
                  alt="Кастомизация шаньдунской рамэн"
                />
                <h3>Шаньдунская лапша рамэн</h3>
              </article>
            </div>
          </div>

          <a class="products-more" href={withBase("/ru/products/")}>
            Смотреть все <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="history-section" aria-labelledby="history-section-title">
        <div class="history-inner">
          <div class="section-heading">
            <h2 id="history-section-title">История</h2>
          </div>

          <div class="history-carousel" data-history-carousel>
            <button
              class="history-nav history-nav-prev"
              type="button"
              data-history-prev
              aria-label="Показать предыдущие события"
            >
              &lsaquo;
            </button>

            <div
              class="history-scroll"
              aria-label="Хронология развития компании с 1995 года до наших дней"
            >
              <ol class="history-track" data-history-track>
                <li class="history-item">
                  <time datetime="1995">1995</time>
                  <span></span>
                  <p>
                    Основана в Цзинине, Шаньдун, начав с мукомольной переработки
                    и производства базовых продуктов питания.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2000">2000</time>
                  <span></span>
                  <p>
                    Запущена производственная база в Цзинине, выведя Lisheng к
                    стандартизированному пищевому производству.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2005">2005</time>
                  <span></span>
                  <p>
                    База в Чэнъу расширила мукомольные мощности в ключевом
                    пшеничном регионе юго-западного Шаньдуна.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2006">2006</time>
                  <span></span>
                  <p>
                    Создана и введена в эксплуатацию мукомольно-макаронная база в
                    Вэньшане.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2007">2007</time>
                  <span></span>
                  <p>
                    Пшеничная мука «Lisheng» удостоена звания «Топ-бренд Китая».
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2009">2009</time>
                  <span></span>
                  <p>
                    В Хэбэе создана мукомольная база в Шэньчжоу, расширив
                    производство за пределы Шаньдуна.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2011">2011</time>
                  <span></span>
                  <p>
                    Торговая марка Lisheng признана «Известной торговой маркой
                    Китая».
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2016">2016</time>
                  <span></span>
                  <p>
                    В Хуасяне, ключевом уезде пшеничного сердца Китая, основана
                    Henan Lisheng.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2018">2018</time>
                  <span></span>
                  <p>
                    Создан умный завод в Ляншане — проект стоимостью 1 млрд
                    юаней, перемалывающий 3 000 тонн пшеницы в сутки.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2020">2020</time>
                  <span></span>
                  <p>
                    В группу вошла Shandong Ruili Food Technology, расширив
                    деятельность на замороженные и глубоко переработанные
                    продукты.
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2026">Сегодня</time>
                  <span></span>
                  <p>
                    Интегрированная цепочка от закупки и помола пшеницы до
                    готовых к экспорту OEM-поставок лапши.
                  </p>
                </li>
              </ol>
            </div>

            <button
              class="history-nav history-nav-next"
              type="button"
              data-history-next
              aria-label="Показать следующие события"
            >
              &rsaquo;
            </button>
          </div>
        </div>
