---
import { withBase } from "../../lib/url";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import "../../styles/global.css";
import "../../styles/subpage.css";
import "../../styles/news.css";

// Data-driven list: one card per markdown file in src/data/news/.
// English copy lives in src/data/news-en/{id}.md and takes precedence when
// present; any article not yet translated falls back to the Chinese source.
// Frontmatter `category` ("company" | "industry") drives the two filters.
type NewsMod = { frontmatter: Record<string, any>; rawContent: () => string };
const zhModules = import.meta.glob<NewsMod>("../../data/news/*.md", { eager: true });
const enModules = import.meta.glob<NewsMod>("../../data/news-en/*.md", { eager: true });
const idOf = (p: string) => (p.split("/").pop() ?? "").replace(".md", "");
const enById = new Map(Object.entries(enModules).map(([p, m]) => [idOf(p), m]));

const articles = Object.entries(zhModules)
  .map(([path, zhMod]) => {
    const id = idOf(path);
    const en = enById.get(id);
    const mod = en ?? zhMod;
    const fm = mod.frontmatter;
    const date = (
      fm.date instanceof Date ? fm.date.toISOString() : String(fm.date)
    ).slice(0, 10);
    const category = fm.category === "industry" ? "industry" : "company";
    // Excerpt: first real text line of the body (skip repeated title / images),
    // stripped of markdown markers.
    const firstText = mod
      .rawContent()
      .split("\n")
      .map((l) => l.trim())
      .find(
        (l) => l && !l.startsWith("![") && !l.startsWith("#") && l !== fm.title
      );
    let excerpt = (firstText ?? "").replace(/[*_>`]/g, "").trim();
    if (en) {
      // English: keep word spacing, truncate by length.
      excerpt = excerpt.replace(/\s+/g, " ");
      if (excerpt.length > 120) excerpt = excerpt.slice(0, 120).trim() + "…";
    } else {
      // Chinese (untranslated fallback): collapse stray spaces, shorter cap.
      excerpt = excerpt.replace(/\s+/g, "");
      if (excerpt.length > 64) excerpt = excerpt.slice(0, 64) + "…";
    }
    const intlReady = fm.intlReady === true;
    const generated = fm.generated === true;
    return { id, title: fm.title as string, date, cover: fm.cover as string, category, excerpt, intlReady, generated };
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>News | Lisheng International</title>
    <meta
      name="description"
      content="Company news from Lisheng Group: new products, production milestones, awards, community work and market updates."
    />
  </head>
  <body>
    <Header langAltHref="/zh/news/" />

    <main>
      <section class="page-hero" aria-labelledby="news-hero-title">
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">Company Updates</p>
          <h1 id="news-hero-title">News</h1>
          <p class="page-hero-copy">
            Product launches, production milestones, awards and stories from
            across the Lisheng Group.
          </p>
        </div>
      </section>

      <section class="news-listing" aria-labelledby="news-listing-title">
        <div class="news-listing-inner">
          <h2 id="news-listing-title" class="sr-only">All news</h2>

          <div class="news-tabs" role="tablist" aria-label="News categories">
            <button class="active" type="button" data-news-cat="company">
              Company News
            </button>
            <button type="button" data-news-cat="industry">Industry News</button>
          </div>

          <div class="news-grid" data-news-grid>
            {articles.map((a) => (
              <NewsCard
                category={a.category}
                image={a.cover}
                href={withBase(`/news/${a.id}/`)}
                date={a.date}
                title={a.title}
                excerpt={a.excerpt}
                intlReady={a.intlReady}
                generated={a.generated}
              />
            ))}
          </div>

          <nav class="news-pagination" aria-label="News pages">
            <button
              class="news-page-nav"
              type="button"
              data-news-prev
              aria-label="Previous page"
            >
              &lsaquo;
            </button>
            <span class="news-page-status" data-news-status>1 / 1</span>
            <button
              class="news-page-nav"
              type="button"
              data-news-next
              aria-label="Next page"
            >
              &rsaquo;
            </button>
          </nav>
        </div>
      </section>
    </main>

    <Footer showCta={false} />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>

    <script>
      // Category filter + client-side pagination (8 cards per page).
      const PAGE_SIZE = 8;
      const grid = document.querySelector("[data-news-grid]");
      const allCards = grid
        ? Array.from(grid.querySelectorAll<HTMLElement>(".news-card"))
        : [];
      const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-news-cat]")
      );
      const prev =
        document.querySelector<HTMLButtonElement>("[data-news-prev]");
      const next =
        document.querySelector<HTMLButtonElement>("[data-news-next]");
      const status = document.querySelector("[data-news-status]");

      let category = "company";
      let page = 0;

      const visible = () =>
        allCards.filter((c) => c.dataset.category === category);

      const render = () => {
        const cards = visible();
        const pages = Math.max(1, Math.ceil(cards.length / PAGE_SIZE));
        if (page > pages - 1) page = pages - 1;
        allCards.forEach((c) => (c.hidden = true));
        cards.forEach((card, i) => {
          card.hidden = i < page * PAGE_SIZE || i >= (page + 1) * PAGE_SIZE;
        });
        if (status) status.textContent = `${page + 1} / ${pages}`;
        if (prev) prev.disabled = page === 0;
        if (next) next.disabled = page === pages - 1;
      };

      const goTo = (target: number) => {
        const pages = Math.max(1, Math.ceil(visible().length / PAGE_SIZE));
        const clamped = Math.max(0, Math.min(target, pages - 1));
        if (clamped === page) return;
        page = clamped;
        sessionStorage.setItem("lisheng-news-page", String(page));
        render();
      };

      const tabCat = (t: HTMLButtonElement) => t.dataset.newsCat || "company";

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const nextCat = tabCat(tab);
          if (nextCat === category) return;
          category = nextCat;
          page = 0;
          tabs.forEach((t) => t.classList.toggle("active", t === tab));
          sessionStorage.removeItem("lisheng-news-page");
          render();
        });
      });

      // Restore page + category only when returning from an article.
      const params = new URLSearchParams(location.search);
      if (params.has("from")) {
        const savedCat = sessionStorage.getItem("lisheng-news-cat");
        if (savedCat === "industry") {
          category = "industry";
          tabs.forEach((t) =>
            t.classList.toggle("active", tabCat(t) === "industry")
          );
        }
        const saved = Number(sessionStorage.getItem("lisheng-news-page"));
        if (Number.isFinite(saved) && saved > 0) page = saved;
        history.replaceState(null, "", "/news/");
      } else {
        sessionStorage.removeItem("lisheng-news-page");
      }

      prev?.addEventListener("click", () => goTo(page - 1));
      next?.addEventListener("click", () => goTo(page + 1));
      // Remember the active category for the back-from-article restore.
      tabs.forEach((tab) =>
        tab.addEventListener("click", () =>
          sessionStorage.setItem("lisheng-news-cat", category)
        )
      );
      render();
    </script>
  </body>
</html>
