---
import { withBase } from "../../lib/url";
import type { MarkdownInstance } from "astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import "../../styles/global.css";
import "../../styles/subpage.css";
import "../../styles/news-article.css";

type NewsFrontmatter = {
  title: string;
  date: string | Date;
  source?: string;
  cover?: string;
};

type NewsModule = MarkdownInstance<NewsFrontmatter>;

// Reusable article template: one page per markdown file in src/data/news/.
// English copy in src/data/news-en/{id}.md takes precedence; articles not yet
// translated fall back to the Chinese source so every page still builds.
export async function getStaticPaths() {
  const zhMods = import.meta.glob<NewsModule>("../../data/news/*.md", {
    eager: true,
  });
  const enMods = import.meta.glob<NewsModule>("../../data/news-en/*.md", {
    eager: true,
  });
  const idOf = (p: string) => (p.split("/").pop() ?? "").replace(".md", "");
  const enById = new Map(Object.entries(enMods).map(([p, m]) => [idOf(p), m]));
  return Object.entries(zhMods).map(([path, zhMod]) => {
    const id = idOf(path);
    const en = enById.get(id);
    return { params: { id }, props: { mod: en ?? zhMod, translated: !!en } };
  });
}

interface Props {
  mod: NewsModule;
  translated: boolean;
}

const { mod, translated } = Astro.props;
const fm = mod.frontmatter;
// English article when translated; otherwise the body is still the Chinese source.
const bodyLang = translated ? "en" : "zh-CN";
const kicker = fm.category === "industry" ? "Industry News" : "Company News";
const emptyText = translated
  ? "The original article on the company website is image-only; the text is being prepared."
  : "本篇新闻官网原文为图片版，文字内容整理中。";

const title = fm.title;
// Frontmatter dates may arrive as Date objects or full ISO strings —
// normalise to YYYY-MM-DD either way.
const date = (
  fm.date instanceof Date ? fm.date.toISOString() : String(fm.date)
).slice(0, 10);
const cover = fm.cover || "/images/news/default-news-cover.webp";
const source = fm.source || "";
const hasBody = mod.rawContent().trim().length > 0;

// Body images come from the markdown (`![](/images/news/...)`) and bypass
// Astro's attribute handling, so prefix the base on the compiled HTML.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bodyHtml = hasBody
  ? (await mod.compiledContent())
      .replaceAll('"/images/', `"${base}/images/`)
      .replaceAll('href="/', `href="${base}/`)
  : "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>{title} | Lisheng International</title>
    <meta name="description" content={`Lisheng Group news: ${title}`} />
  </head>
  <body>
    <Header langAltHref={`/zh/news/${Astro.params.id}/`} />

    <main>
      <section class="page-hero" aria-labelledby="article-title">
        <img src={withBase(cover)} alt={title} />
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">{kicker}</p>
          <h1 id="article-title">{title}</h1>
        </div>
      </section>

      <article class="article-section">
        <div class="article-inner">
          <a class="article-back" href={withBase("/news/?from=article")}>← Back to News</a>

          <div class="article-meta">
            <time datetime={date}>{date}</time>
            {source && (
              <a href={source} target="_blank" rel="noopener">
                Original article (lishengmf.com)
              </a>
            )}
          </div>

          <div class="article-body" lang={bodyLang}>
            {hasBody ? (
              <Fragment set:html={bodyHtml} />
            ) : (
              <p class="article-empty">{emptyText}</p>
            )}
          </div>
        </div>
      </article>
    </main>

    <Footer showCta={false} />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>
  </body>
</html>
