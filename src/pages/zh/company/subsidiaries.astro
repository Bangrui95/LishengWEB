---
import Seo from "../../../components/Seo.astro";
import { withBase } from "../../../lib/url";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import "../../../styles/global.css";
import "../../../styles/subpage.css";
import "../../../styles/company-subsidiaries.css";
import "../../../styles/zh.css";

// 每家子公司一条——后续替换占位图片。
const subsidiaries = [
  {
    name: "山东利生食品集团有限公司",
    year: "1995",
    kicker: "总部 · 济宁",
    image: "/images/company/subsidiaries/jining-hq.webp",
    facts: ["济宁，山东", "450+ 员工", "日处理小麦 1,100 吨", "日产挂面 200 吨"],
    copy: "集团创始公司与总部，位于济宁高新技术产业开发区柳行街道。拥有 450 余名员工及庞大的工程师与管理团队，配备布勒（Bühler）生产设备与波通（Perten）检测仪器，日处理小麦 1,100 吨、挂面 200 吨、大米 200 吨。三大产品系列涵盖 60 多个品种，畅销全国 30 个省、300 多个城市。工厂通过 ISO 9001、ISO 14001 与 ISO 22000 认证，持有国家“放心粮油”与无公害农产品资质；2011 年 11 月，“利生”商标被认定为中国驰名商标。",
  },
  {
    name: "山东利生集团汶上面业有限公司",
    year: "2005",
    kicker: "生产基地 · 汶上",
    image: "/images/company/subsidiaries/wenshang.webp",
    facts: ["汶上，济宁", "300+ 员工", "日处理小麦 1,000 吨", "日产挂面 200 吨"],
    copy: "全资子公司，成立于 2005 年，注册资本 4,000 万元，坐落于汶上优质小麦产区、105 国道旁，占地 33,000 平方米，公路、铁路、水路交通便利。约 300 名员工运营面粉与挂面一体化工厂，配备布勒设备与波通仪器，日处理小麦 1,000 吨、挂面 200 吨，生产两大系列、60 多个品种，畅销全国 260 多个城市。通过 ISO 9001、ISO 14001 与 ISO 22000 认证，产品获“山东省十大面粉行业品牌”“全国知名挂面品牌”称号。",
  },
  {
    name: "山东利生集团成武食品有限公司",
    year: "2008",
    kicker: "生产基地 · 菏泽成武",
    image: "/images/company/subsidiaries/chengwu.webp",
    facts: ["成武，山东", "300+ 员工", "日处理小麦 1,000 吨", "日产挂面 200 吨"],
    copy: "控股子公司，位于成武县九女集镇——国家级粮食生产保护区，京九、日菏、陇海铁路三面环绕。占地 35,000 平方米，总资产 8,000 万元，300 余名员工日处理小麦 1,000 吨、挂面 200 吨。工厂采用整套布勒设备，由郑州粮食学院制粉专家设计工艺：五皮八心制粉、五道清粉、中路出粉——面粉以白度高、麦香浓、品质稳定著称，畅销北方近十个省份。连续多年获银行系统评定为 AA 级信用企业。",
  },
  {
    name: "山东利生集团深州面业有限公司",
    year: "2009",
    kicker: "生产基地 · 河北深州",
    image: "/images/company/subsidiaries/shenzhou.webp",
    facts: ["深州，河北", "日处理小麦 600 吨", "年产面粉 18 万吨", "17 万亩小麦基地"],
    copy: "集团河北基地，位于深州太古庄工业园，是当地重点招商引资项目。68 人团队日加工华北平原小麦 600 吨，采用先进的 MDDK 辊式磨粉机与清粉机，年产面粉达 18 万吨，产销率 100%，覆盖从北京到广东的 20 多个大中城市。深州率先开创集团“公司 + 基地 + 农户”模式：17 万亩优质小麦基地、联结 1.8 万农户，统一供种、统一种植指导、统一收购——在小麦进厂前即锁定原粮品质。",
  },
  {
    name: "河南利生面业有限公司",
    year: "2016",
    kicker: "生产基地 · 河南滑县",
    image: "/images/company/subsidiaries/henan.webp",
    facts: ["滑县，河南", "100 名员工", "20 名技术专家"],
    copy: "成立于 2016 年，注册资本 3,360 万元，坐落于滑县新区，占地 101 亩——滑县素有“中国小麦第一县”之称，年种植小麦近 180 万亩、收获优质粮近十亿公斤，单产连续近三十年领跑河南。该项目是县政府重点招商项目，100 人团队（含 20 名中高级技术专家）将利生的生产网络延伸至河南小麦主产区腹地。",
  },
  {
    name: "梁山利生食品有限公司",
    year: "2018",
    kicker: "旗舰智能工厂 · 梁山",
    image: "/images/company/subsidiaries/liangshan.webp",
    facts: ["梁山，山东", "投资 10 亿元", "日产专用粉 3,000 吨", "年加工小麦 100 万吨"],
    copy: "全资子公司，成立于 2018 年 8 月，注册资本 4,300 万元——总投资 10 亿元的智能粮食产业项目，占地 153,180 平方米。四条智能制粉生产线日产专用粉 3,000 吨，年加工小麦 100 万吨，全程 PLC 与 MES 控制——从小麦入仓到码垛基本实现无人化。低温研磨保留营养与麦香；2 万平方米屋顶光伏装机 2 兆瓦，太阳能供热用于挂面烘干房。该工厂是集团产能倍增战略与进军高档专用粉的核心支点。",
  },
  {
    name: "山东瑞利食品科技有限公司",
    year: "2020",
    kicker: "食品科技 · 济宁",
    image: "/images/company/subsidiaries/ruili.webp",
    facts: ["济宁，山东", "冷冻食品线", "深加工研发"],
    copy: "2020 年 12 月加入集团，作为食品科技板块，落户济宁。瑞利将产业链延伸至冷冻食品与深加工——把利生的面粉与挂面能力应用于新一代便利食品，冷冻食品销售线已投入运营。",
  },
  {
    name: "济宁天宇彩印包装有限公司",
    kicker: "包装 · 集团包装资源",
    image: "/images/company/subsidiaries/tianyu.webp",
    facts: ["济宁，山东", "自有包装", "自有品牌配套"],
    copy: "集团自有包装公司，位于济宁，为利生产品与 OEM 项目生产薄膜与纸箱包装。将包装设计与生产保留在集团内部，正是利生能为出口客户提供灵活的自有品牌包装、小批量图案更换与快速包装交付的关键。",
  },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>下属公司 | 利生集团</title>
    <meta
      name="description"
      content="山东利生集团旗下八家子公司：分布于山东、河北、河南的面粉与挂面生产基地，以及食品科技与包装公司。"
    />
    <Seo title={"下属公司 | 利生集团"} description={"山东利生集团旗下八家子公司：分布于山东、河北、河南的面粉与挂面生产基地，以及食品科技与包装公司。"} />
  </head>
  <body>
    <Header lang="zh" langAltHref="/company/subsidiaries/" />

    <main>
      <section class="page-hero" aria-labelledby="sub-hero-title">
        <img src={withBase("/images/company/about/lisheng.webp")} alt="利生集团子公司" />
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">集团结构</p>
          <h1 id="sub-hero-title">下属公司</h1>
          <p class="page-hero-copy">
            横跨山东、河北、河南的八家公司——生产基地、食品科技与包装，共属一条供应链。
          </p>
        </div>
      </section>

      <section class="page-section" aria-labelledby="sub-list-title">
        <div class="page-section-inner">
          <p class="company-kicker">旗下公司</p>
          <h2 id="sub-list-title">一个集团，<br />八家专业化公司</h2>
          <p>
            每个生产基地都坐落于国家级优质小麦产区，食品科技与包装公司则将链条从原粮延伸至零售成品。它们共有员工逾 1,300 人，另有三家粮食收储公司、仓储能力 20 万吨。
          </p>

          <div class="subsidiary-list-block">
            {subsidiaries.map((sub, i) => (
              <article class={`subsidiary-card ${i % 2 === 1 ? "reverse" : ""}`}>
                <div class="subsidiary-media">
                  <img src={withBase(sub.image)} alt={`${sub.name}厂区`} />
                </div>
                <div class="subsidiary-copy">
                  {sub.year && <span class="subsidiary-year">{sub.year}</span>}
                  <p class="company-kicker">{sub.kicker}</p>
                  <h3>{sub.name}</h3>
                  <p>{sub.copy}</p>
                  <ul class="subsidiary-facts" aria-label="关键信息">
                    {sub.facts.map((fact) => (
                      <li>{fact}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>

          <div class="company-cta">
            <div>
              <h2>全集团一个对接窗口</h2>
              <p>
                无论哪个基地适合您的产品，OEM 咨询都由同一支出口团队对接。
              </p>
            </div>
            <a class="company-cta-link" href={withBase("/contact/")}>
              获取报价 <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang="zh" />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>
  </body>
</html>
