---
import { withBase } from "../../lib/url";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import HeroSlider from "../../components/HeroSlider.astro";
import WorldMap from "../../components/WorldMap.astro";
import "../../styles/global.css";
import "../../styles/index.css";
import "../../styles/ja.css";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>Lisheng International</title>
    <meta
      name="description"
      content="世界の食品ブランド・輸入業者・流通向けのプライベートブランド麺OEM製造。"
    />
    <meta name="author" content="Bangrui Wang / Design095" />
  </head>
  <body>
    <Header lang="ja" />
    <main>
      <HeroSlider />
      <section class="company-overview" aria-labelledby="company-overview-title">
        <div class="overview-copy">
          <h2 id="company-overview-title">
            世界の食品ブランドのための<br />
            輸出対応の麺製造
          </h2>
          <p>
            Lisheng は、海外の輸入業者、プライベートブランド、HoReCa 流通業者に、オーダーメイドの麺・小麦粉製造、自社包装サポート、国際市場向けの安定供給を提供します。</p>
        </div>

        <div class="overview-stats">
          <div class="stats-row stats-row-primary">
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="30+">
                  <span class="stat-digit" aria-hidden="true">3</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>食品製造の経験年数</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="20+">
                  <span class="stat-digit" aria-hidden="true">2</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>製品ラインとカスタム製造</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="6+">
                  <span class="stat-digit" aria-hidden="true">6</span>
                  <span class="stat-symbol" aria-hidden="true">+</span>
                </span>
              </dt>
              <dd>輸出市場</dd>
            </dl>
          </div>

          <div class="stats-row stats-row-secondary">
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="30億">
                  <span class="stat-digit" aria-hidden="true">3</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                </span>
                <span class="stat-unit">億</span>
              </dt>
              <dd>年間売上高</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="7,000">
                  <span class="stat-digit" aria-hidden="true">7</span>
                  <span class="stat-comma" aria-hidden="true">,</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                </span>
                <span class="stat-unit">トン</span>
              </dt>
              <dd>1日あたりの小麦処理量</dd>
            </dl>
            <dl class="stat-item">
              <dt>
                <span class="stat-number" aria-label="560">
                  <span class="stat-digit" aria-hidden="true">5</span>
                  <span class="stat-digit" aria-hidden="true">6</span>
                  <span class="stat-digit" aria-hidden="true">0</span>
                </span>
                <span class="stat-unit">トン</span>
              </dt>
              <dd>1日あたりの麺生産量</dd>
            </dl>
          </div>
        </div>
      </section>

      <section class="featured-links" aria-labelledby="featured-links-title">
        <h2 id="featured-links-title" class="sr-only">会社の注目リンク</h2>

        <article class="featured-report">
          <div class="report-image">
            <img
              src={withBase("/images/home/oem-noodle-packaging-display.webp")}
              alt="OEM麺包装と製品ディスプレイ"
            />
          </div>
          <div class="report-copy">
            <h3>プライベートブランド・OEM供給</h3>
            <p>
              海外の輸入業者、小売ブランド、HoReCa 流通業者向けのオーダーメイド麺・小麦粉製造。製品仕様、包装形態、輸出対応の供給をサポートします。</p>
            <div class="report-actions" aria-label="OEMガイドのリンク">
              <a class="report-action" href={withBase("/ja/services/")}>
                <span>プライベートブランド製造ガイド</span>
                <span aria-hidden="true">→</span>
              </a>
              <a class="report-action" href={withBase("/ja/services/customization/")}>
                <span>製品カスタマイズ</span>
                <span aria-hidden="true">→</span>
              </a>
              <a class="report-action" href={withBase("/ja/contact/")}>
                <span>プライベートブランド案件を始める</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <div class="feature-card-grid">
          <article class="feature-card">
            <img
              src={withBase("/images/home/noodle-manufacturing-company-overview.webp")}
              alt="Lisheng 製造会社の概要"
            />
            <div class="feature-card-copy">
              <h3>製造能力</h3>
              <p>
                小麦加工、製麺、包装、物流を網羅する統合型製造システム。安定した品質、拡張可能な生産、長期供給を実現します。</p>
              <a href={withBase("/ja/company/")}>詳しく見る</a>
            </div>
          </article>

          <article class="feature-card">
            <img
              src={withBase("/images/main/products.webp")}
              alt="カスタム麺製品とサービス"
            />
            <div class="feature-card-copy">
              <h3>製品ラインナップ</h3>
              <p>
                麺から小麦粉、プライベートブランド包装まで、Lisheng は小売・HoReCa・輸出チャネル向けに適応可能な製品ラインを開発します。各製品は市場ニーズに合わせてカスタマイズできます。</p>
              <a href={withBase("/ja/products/")}>詳しく見る</a>
            </div>
          </article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="about-section-title">
        <div class="about-inner">
          <div class="about-left-panel">
            <div class="about-media">
              <img
                src={withBase("/images/icon/logo.webp")}
                alt="Lisheng Group ロゴ"
              />
            </div>

            <div class="subsidiary-list" aria-label="Lisheng Group のグループ会社">
              <h2>グループ会社</h2>
              <ul>
                <li>Shandong Lisheng Food Group</li>
                <li>Shandong Lisheng Group Chengwu Food</li>
                <li>Shandong Lisheng Group Wenshang Flour Industry</li>
                <li>Shandong Lisheng Group Shenzhou Flour</li>
                <li>Henan Lisheng Flour Industry</li>
                <li>Liangshan Lisheng Food</li>
                <li>Shandong Ruili Food Technology</li>
                <li>Jining Tianyu Color Printing & Packaging</li>
              </ul>
            </div>
          </div>

          <div class="about-copy">
            <h2 id="about-section-title">会社概要</h2>
            <p>
              Shandong Lisheng Group は1995年創業、山東省済寧市のハイテク産業
              開発区にあります。Lisheng グループは「人々の日常に役立つ事業を
              創る」という企業理念を一貫して掲げています。品質、規模、誠実さ、
              ブランド価値、サービスにおける強みを最大限に活かし、個性豊かで
              技術力が高く、中核的な競争力を備えた大手食品グループを目指して
              います。
            </p>
            <p>
              グループの製品は、中国の30の省・直轄市・自治区にある260以上の
              大中都市で販売されています。乾麺は東南アジア、ヨーロッパなどの
              国際市場へも輸出されています。
            </p>
            <p>
              グループは6つの製粉拠点、3つの乾麺生産工場、3つの穀物倉庫会社を
              有します。1日あたりの小麦処理量は7,000トン、乾麺生産量は560トン、
              穀物貯蔵能力は20万トン。穀物の貯蔵・加工・販売・物流を統合した
              大手グループ企業です。
            </p>
            <a class="about-more" href={withBase("/ja/company/")}>詳しく見る</a>
          </div>

          <div class="about-rd" aria-labelledby="about-rd-title">
            <div class="about-rd-main">
              <div class="about-rd-copy">
                <p>製品の研究開発</p>
                <h3 id="about-rd-title">R&Dセンター</h3>
                <span>
                  Lisheng は、小麦粉、乾麺、関連する穀物製品を網羅する独立した
                  製品開発システムを有しています。原料試験、配合調整、麺の食感
                  開発、包装試験の経験を活かし、さまざまな市場ニーズに合わせた
                  製品改良を支えています。
                </span>
                <span>
                  また、同社は食品製造の発明特許を10件以上保有しており、製品
                  革新、工程最適化、安定した工業生産における長期的な実力を
                  強化しています。
                </span>
                <a class="about-more" href={withBase("/ja/factory/lab/")}>詳しく見る</a>
              </div>

              <div
                class="about-rd-media"
                aria-label="R&Dと製品開発の写真"
              >
                <img
                  src={withBase("/images/home/rd-specialist-checking-noodle-samples.webp")}
                  alt="麺サンプルを確認するR&D専門家"
                />
                <img
                  src={withBase("/images/home/rd-team-product-development.webp")}
                  alt="製品開発を議論するR&Dチーム"
                />
                <img
                  src={withBase("/images/home/noodle-research-sample-testing.webp")}
                  alt="麺の研究とサンプル試験"
                />
              </div>

              <dl class="about-rd-points" aria-label="R&Dの主な能力">
                <div>
                  <dt>配合開発</dt>
                  <dd>
                    さまざまな製品要件に合わせた小麦粉・生地配合の試験と調整
                  </dd>
                </div>
                <div>
                  <dt>工程の最適化</dt>
                  <dd>
                    自社の特許食品加工技術による生産安定性の向上
                  </dd>
                </div>
                <div>
                  <dt>製品基準</dt>
                  <dd>
                    各市場向けの食品安全試験、小売・HoReCa・輸出仕様に対応
                  </dd>
                </div>
              </dl>
            </div>

            <div class="about-factory" aria-labelledby="about-factory-title">
              <div
                class="about-factory-media"
                aria-label="工場加工と自動生産の写真"
              >
                <img
                  src={withBase("/images/home/automated-factory-processing-line.webp")}
                  alt="自動化された工場ラインの概観"
                />
                <img
                  src={withBase("/images/home/noodle-processing-machinery.webp")}
                  alt="製麺加工機械と生産設備"
                />
                <img
                  src={withBase("/images/home/factory-machining-automated-system.webp")}
                  alt="工場加工と自動生産システム"
                />
              </div>

              <div class="about-factory-copy">
                <p>フルサイクル生産</p>
                <h3 id="about-factory-title">
                  生産力
                </h3>
                <span>
                  Lisheng は、原料調達、製粉加工、製麺、包装、保管、物流、販売
                  サポートを網羅する統合型の食品製造システムを構築しています。
                  このフルチェーンの能力により、長期パートナーに対して安定した
                  品質、効率的な生産、確実な供給を実現します。
                </span>
                <span>
                  さまざまな市場ニーズに応じて、製品サイズ、食感、配合、包装
                  形態、注文要件を含む麺のオーダー仕様に対応します。自社の包装
                  設備を持つため、小売・HoReCa・卸・プライベートブランド製品
                  向けに柔軟な包装ソリューションも提供できます。
                </span>
                <a class="about-more" href={withBase("/ja/factory/production/")}>詳しく見る</a>
              </div>

              <dl
                class="about-factory-stats"
                aria-label="工場加工の主な特長"
              >
                <div>
                  <dt>加工</dt>
                  <dd>
                    安定した生産管理による製粉・製麺の統合生産
                  </dd>
                </div>
                <div>
                  <dt>カスタマイズ</dt>
                  <dd>
                    各市場向けの麺のサイズ・食感・配合・包装オプション
                  </dd>
                </div>
                <div>
                  <dt>包装</dt>
                  <dd>
                    小売・HoReCa・プライベートブランド製品向けの自社包装サポート
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <section class="products-section" aria-labelledby="products-section-title">
        <div class="products-inner">
          <div class="section-heading">
            <h2 id="products-section-title">製品</h2>
          </div>

          <div
            class="product-tabs"
            role="tablist"
            aria-label="製品カテゴリー"
          >
            <button
              class="active"
              type="button"
              role="tab"
              aria-selected="true"
              data-product-tab="noodles"
            >
              麺
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-product-tab="flour"
            >
              小麦粉
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-product-tab="customization"
            >
              カスタムソリューション
            </button>
          </div>

          <div class="product-panels">
            <div class="product-panel active" data-product-panel="noodles">
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/whole-wheat-noodles-500-g.webp")}
                  alt="麺シリーズ"
                />
                <h3>麺シリーズ</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/whole-wheat-noodles-1-kg.webp")}
                  alt="包装済み麺"
                />
                <h3>包装済み麺</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/buckwheat-noodles.webp")}
                  alt="小売向け麺ラインナップ"
                />
                <h3>小売向け麺ラインナップ</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/noodles1/royal-egg-noodles.webp")}
                  alt="麺の輸出供給"
                />
                <h3>麺の輸出供給</h3>
              </article>
            </div>

            <div class="product-panel" data-product-panel="flour" hidden>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/eight-star-strong-gluten-wheat-flour.webp")}
                  alt="小麦粉"
                />
                <h3>小麦粉</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/seven-star-strong-gluten-wheat-flour.webp")}
                  alt="プレミアム小麦粉"
                />
                <h3>プレミアム小麦粉シリーズ</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/six-star-strong-gluten-wheat-flour.webp")}
                  alt="食品製造向け小麦粉"
                />
                <h3>食品製造向け小麦粉</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/flour1/eight-star-snowflake-flour.webp")}
                  alt="輸出対応の小麦粉包装"
                />
                <h3>小麦粉の輸出包装</h3>
              </article>
            </div>

            <div class="product-panel" data-product-panel="customization" hidden>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/shanghai-yangchun-noodles.webp")}
                  alt="上海陽春麺のカスタマイズ"
                />
                <h3>上海 陽春麺</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/lanzhou-ramen-noodles.webp")}
                  alt="蘭州拉麺のカスタマイズ"
                />
                <h3>蘭州拉麺</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/sichuan-dandan-noodles.webp")}
                  alt="四川担担麺のカスタマイズ"
                />
                <h3>四川 担担麺</h3>
              </article>
              <article class="product-card">
                <img
                  src={withBase("/images/products/customization1/shandong-ramen-noodles.webp")}
                  alt="山東ラーメンのカスタマイズ"
                />
                <h3>山東ラーメン</h3>
              </article>
            </div>
          </div>

          <a class="products-more" href={withBase("/ja/products/")}>
            すべて見る <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="history-section" aria-labelledby="history-section-title">
        <div class="history-inner">
          <div class="section-heading">
            <h2 id="history-section-title">沿革</h2>
          </div>

          <div class="history-carousel" data-history-carousel>
            <button
              class="history-nav history-nav-prev"
              type="button"
              data-history-prev
              aria-label="前の出来事を表示"
            >
              &lsaquo;
            </button>

            <div
              class="history-scroll"
              aria-label="1995年から現在までの会社の沿革"
            >
              <ol class="history-track" data-history-track>
                <li class="history-item">
                  <time datetime="1995">1995</time>
                  <span></span>
                  <p>
                    山東省済寧市で創業。製粉加工と基礎食品の生産から出発。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2000">2000</time>
                  <span></span>
                  <p>
                    済寧の生産拠点を稼働させ、Lisheng を標準化された食品生産へと
                    導く。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2005">2005</time>
                  <span></span>
                  <p>
                    成武の拠点が、山東省南西部の主要小麦産地で製粉能力を拡大。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2006">2006</time>
                  <span></span>
                  <p>
                    汶上に製粉・製麺拠点を新設・稼働。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2007">2007</time>
                  <span></span>
                  <p>
                    「Lisheng」小麦粉が「中国トップブランド」を受賞。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2009">2009</time>
                  <span></span>
                  <p>
                    河北省深州に製粉拠点を新設し、山東省外へ生産を拡大。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2011">2011</time>
                  <span></span>
                  <p>
                    Lisheng 商標が「中国著名商標」に認定。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2016">2016</time>
                  <span></span>
                  <p>
                    中国の小麦中心地の主要県・滑県に Henan Lisheng を設立。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2018">2018</time>
                  <span></span>
                  <p>
                    梁山にスマート工場を建設——総額10億元、1日3,000トンの小麦を
                    製粉するプロジェクト。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2020">2020</time>
                  <span></span>
                  <p>
                    Shandong Ruili Food Technology がグループ入りし、冷凍・高度
                    加工製品へ事業を拡大。
                  </p>
                </li>
                <li class="history-item">
                  <time datetime="2026">現在</time>
                  <span></span>
                  <p>
                    小麦の買付け・製粉から輸出対応のOEM麺供給までの統合チェーン。
                  </p>
                </li>
              </ol>
            </div>

            <button
              class="history-nav history-nav-next"
              type="button"
              data-history-next
              aria-label="次の出来事を表示"
            >
              &rsaquo;
            </button>
          </div>
        </div>
      </section>

      <!-- Our Brands section hidden for now — uncomment to restore.
      <section class="brands-section" aria-labelledby="brands-section-title">
        <div class="brands-inner">
