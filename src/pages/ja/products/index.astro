    <script>
      // Open the tab matching the URL hash (e.g. /products/#flour),
      // including when a dropdown link is clicked while already on this page.
      const activateFromHash = () => {
        const cat = location.hash.replace("#", "");
        if (!cat) return;
        const tab = document.querySelector(`[data-product-tab="${cat}"]`);
        if (tab instanceof HTMLElement) tab.click();
      };
      window.addEventListener("hashchange", activateFromHash);
      activateFromHash();

      // Tab dropdowns (Noodle + Flour, each with Lisheng / Minsheng series).
      // Desktop reveals on hover (CSS); on touch the caret toggles it.
      const tabGroups = Array.from(document.querySelectorAll("[data-tab-group]"));
      tabGroups.forEach((group) => {
        const caret = group.querySelector("[data-tab-caret]");
        caret?.addEventListener("click", (event) => {
          event.stopPropagation();
          // close any other open group, then toggle this one
          tabGroups.forEach((g) => g !== group && g.classList.remove("open"));
          group.classList.toggle("open");
        });
        group
          .querySelectorAll(".tab-dropdown [data-product-tab]")
          .forEach((btn) =>
            btn.addEventListener("click", () => {
              group.classList.remove("open");
              // drop focus so :focus-within doesn't keep the menu pinned open
              (btn as HTMLElement).blur();
            })
          );
      });
      document.addEventListener("click", (event) => {
        tabGroups.forEach((group) => {
          if (!group.contains(event.target as Node)) group.classList.remove("open");
        });
      });

      // Client-side pagination (12 per page) for the Noodle / Flour panels.
      // Custom Solutions (8) and Frozen (12) have no [data-paginate] → nav hides.
      const PAGE_SIZE = 12;
      const pagNav = document.querySelector<HTMLElement>("[data-products-pagination]");
      const pagPrev = document.querySelector<HTMLButtonElement>("[data-products-prev]");
      const pagNext = document.querySelector<HTMLButtonElement>("[data-products-next]");
      const pagStatus = document.querySelector("[data-products-status]");
      const pageOf = new Map<Element, number>();

      const itemsOf = (panel: Element) =>
        Array.from(panel.querySelectorAll<HTMLElement>(".product-tile, .catalog-tile"));

      // Track the active panel ourselves (independent of site.js tab toggling).
      let currentPanel: Element | null = document.querySelector(
        "[data-product-panel]:not([hidden])"
      );

      const renderPagination = () => {
        const paged = !!currentPanel?.hasAttribute("data-paginate");
        if (pagNav) pagNav.hidden = !paged;
        if (!paged || !currentPanel) return;
        const items = itemsOf(currentPanel);
        const pages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
        let page = pageOf.get(currentPanel) ?? 0;
        if (page > pages - 1) page = pages - 1;
        pageOf.set(currentPanel, page);
        items.forEach((el, i) => {
          el.hidden = i < page * PAGE_SIZE || i >= (page + 1) * PAGE_SIZE;
        });
        if (pagStatus) pagStatus.textContent = `${page + 1} / ${pages}`;
        if (pagPrev) pagPrev.disabled = page === 0;
        if (pagNext) pagNext.disabled = page === pages - 1;
      };

      const step = (delta: number) => {
        if (!currentPanel?.hasAttribute("data-paginate")) return;
        const pages = Math.max(
          1,
          Math.ceil(itemsOf(currentPanel).length / PAGE_SIZE)
        );
        const np = Math.max(
          0,
          Math.min((pageOf.get(currentPanel) ?? 0) + delta, pages - 1)
        );
        if (np === pageOf.get(currentPanel)) return;
        pageOf.set(currentPanel, np);
        renderPagination();
        document
          .querySelector(".product-tabs")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      pagPrev?.addEventListener("click", () => step(-1));
      pagNext?.addEventListener("click", () => step(1));

      // On tab / sub-tab switch: point at the new panel and reset it to page 1.
      document.querySelectorAll<HTMLElement>("[data-product-tab]").forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = document.querySelector(
            `[data-product-panel="${tab.dataset.productTab}"]`
          );
          if (!target) return;
          currentPanel = target;
          pageOf.set(target, 0);
          renderPagination();
        });
      });

      renderPagination();
    </script>
  </body>
</html>
