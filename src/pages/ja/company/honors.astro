---
import Seo from "../../../components/Seo.astro";
import { withBase } from "../../../lib/url";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import "../../../styles/global.css";
import "../../../styles/subpage.css";
import "../../../styles/company-honors.css";
import "../../../styles/ja.css";

const IMG = withBase("/images/company/honors");

// Certificate wall — add a new honor by copying one block and swapping the image.
const honors = [
  { img: "china-top-brand-2007.webp", title: "中国トップブランド", year: "2007" },
  { img: "china-famous-trademark-2011.webp", title: "中国著名商標", year: "2011" },
  { img: "key-leading-enterprise-2005.webp", title: "農業産業化国家重点リーディング企業", year: "2005" },
  { img: "national-noodle-brand-2006.webp", title: "全国著名乾麺ブランド", year: "2006" },
  { img: "top50-2011.webp", title: "中国製粉企業トップ50", year: "2011" },
  { img: "top50-2013.webp", title: "中国製粉企業トップ50", year: "2013" },
  { img: "top50-2015.webp", title: "中国製粉企業トップ50", year: "2015" },
  { img: "top50-2017.webp", title: "中国製粉企業トップ50", year: "2017" },
  { img: "top10-grain-oil-2016.webp", title: "中国穀物・油（食糧）十大ブランド", year: "2016" },
  { img: "shandong-brand-flour.webp", title: "山東著名ブランド——小麦粉", year: "山東" },
  { img: "shandong-brand-noodles.webp", title: "山東著名ブランド——乾麺", year: "山東" },
  { img: "shandong-trademark-2009.webp", title: "山東著名商標", year: "2009" },
  { img: "shandong-top20-2007.webp", title: "山東食品工業トップ20", year: "2007" },
  { img: "aaa-credit-2010.webp", title: "AAA信用格付け企業（中国農業銀行）", year: "2010" },
  { img: "contract-trust-2011.webp", title: "省級「契約遵守・信用重視」企業", year: "2011" },
  { img: "grain-emergency-2008.webp", title: "穀物緊急供給指定企業", year: "2008" },
  { img: "demonstration-enterprise-2010.webp", title: "国家模範加工企業", year: "2010" },
  { img: "grain-assoc-member.webp", title: "中国穀物流通協会 会員", year: "会員" },
  { img: "most-influential-brand.webp", title: "最も影響力のあるブランド", year: "業界" },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>受賞・認証 | Lisheng International</title>
    <meta
      name="description"
      content="30年にわたる評価: 中国トップブランド、中国著名商標、製粉企業トップ50など、Lisheng Group の受賞歴。"
    />
    <Seo title={"受賞・認証 | Lisheng International"} description={"30年にわたる評価: 中国トップブランド、中国著名商標、製粉企業トップ50など、Lisheng Group の受賞歴。"} />
  </head>
  <body>
    <Header lang="ja" />

    <main>
      <section class="page-hero" aria-labelledby="honors-hero-title">
        <img
          src={withBase("/images/company/about/lisheng.webp")}
          alt="Lisheng Group ロゴ"
        />
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">評価・実績</p>
          <h1 id="honors-hero-title">受賞・認証</h1>
          <p class="page-hero-copy">
            安定した品質と生産基準に裏打ちされた、30年にわたる国家・省レベルの評価。
          </p>
        </div>
      </section>

      <!-- Milestones by year -->
      <section class="page-section" aria-labelledby="honors-milestones-title">
        <div class="page-section-inner">
          <p class="company-kicker">沿革</p>
          <h2 id="honors-milestones-title">年々積み重ねた実績</h2>

          <ol class="honor-timeline">
            <li>
              <span class="honor-year">2022</span>
              <p>
                山東省初の品質ブランドリスト
                <strong>「山東優品」</strong>に選出。
              </p>
            </li>
            <li>
              <span class="honor-year">2019</span>
              <p>
                中国穀物・油協会より<strong>最も競争力のあるブランド</strong>に
                認定。
              </p>
            </li>
            <li>
              <span class="honor-year">2017</span>
              <p>
                <strong>中国製粉企業トップ50</strong>——再び全国ランキング入り。
              </p>
            </li>
            <li>
              <span class="honor-year">2016</span>
              <p>
                <strong>中国穀物・油（食糧）十大ブランド</strong>に選出。
              </p>
            </li>
            <li>
              <span class="honor-year">2015</span>
              <p>
                <strong>中国製粉企業トップ50</strong>——複数年連続で選出。
              </p>
            </li>
            <li>
              <span class="honor-year">2011</span>
              <p>
                <strong>中国著名商標</strong>——そして<strong>中国製粉企業
                トップ50</strong>に初選出。
              </p>
            </li>
            <li>
              <span class="honor-year">2009</span>
              <p>
                「Lisheng」が<strong>山東著名商標</strong>に認定。
              </p>
            </li>
            <li>
              <span class="honor-year">2007</span>
              <p>
                「Lisheng」小麦粉が<strong>中国トップブランド</strong>を受賞。
              </p>
            </li>
            <li>
              <span class="honor-year">2006</span>
              <p>
                <strong>全国著名乾麺ブランド</strong>に認定。
              </p>
            </li>
            <li>
              <span class="honor-year">2005</span>
              <p>
                省級<strong>農業産業化重点リーディング企業</strong>に認定。
              </p>
            </li>
            <li>
              <span class="honor-year">2003</span>
              <p>
                <strong>ISO 9001、ISO 22000、HACCP</strong>のマネジメント
                システム認証を取得。
              </p>
            </li>
          </ol>
        </div>
      </section>

      <!-- Certificate wall -->
      <section class="page-section alt" aria-labelledby="honors-wall-title">
        <div class="page-section-inner">
          <p class="company-kicker">認証</p>
          <h2 id="honors-wall-title">業界での評価</h2>
          <p>
            生産品質と食品安全基準を裏付ける、公式の認証・受賞・業界評価。
          </p>

          <div class="honor-grid">
            {honors.map((h) => (
              <article class="honor-card">
                <div class="honor-media">
                  <img src={`${IMG}/${h.img}`} alt={h.title} loading="lazy" />
                </div>
                <h3>{h.title}</h3>
                <p>{h.year}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer lang="ja" />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>
  </body>
</html>
