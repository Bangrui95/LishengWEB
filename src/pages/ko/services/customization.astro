---
import Seo from "../../../components/Seo.astro";
import { withBase } from "../../../lib/url";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import "../../../styles/global.css";
import "../../../styles/subpage.css";
import "../../../styles/customization.css";
import "../../../styles/ko.css";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="icon" type="image/png" href={withBase("/images/icon/favicon.png")} />
    <title>제품 맞춤 제작 | Lisheng International</title>
    <meta
      name="description"
      content="면 제품을 단계별로 설계합니다: 원료, 배합, 형상, 샘플, 품질 기준, 수량, 포장, 수출 조건."
    />
    <Seo title={"제품 맞춤 제작 | Lisheng International"} description={"면 제품을 단계별로 설계합니다: 원료, 배합, 형상, 샘플, 품질 기준, 수량, 포장, 수출 조건."} />
  </head>
  <body>
    <Header lang="ko" />

    <main>
      <section class="page-hero" aria-labelledby="customization-hero-title">
        <img
          src={withBase("/images/main/products444.webp")}
          alt="Lisheng이 개발한 맞춤 면 제품"
        />
        <div class="page-hero-overlay"></div>
        <div class="page-hero-inner">
          <p class="page-kicker">고객 사양에 따른 제조</p>
          <h1 id="customization-hero-title">제품 맞춤 제작</h1>
          <p class="page-hero-copy">
            9개 단계를 진행하며 시장에 맞는 항목을 선택해 브리프를 보내주세요
            ——나머지는 당사가 설계합니다.
          </p>
        </div>
      </section>

      <section class="page-section" aria-labelledby="config-title">
        <div class="page-section-inner">
          <p class="config-kicker">제품 브리프 작성</p>
          <h2 id="config-title">면 프로그램 맞춤 설정</h2>
          <p>
            아래 각 선택지는 당사 공장에서 실제로 대응 가능한 것입니다. 각
            단계에서 필요한 항목을 선택하고, 잘 모르는 항목은 건너뛰세요——담당
            팀이 안내해 드립니다.
          </p>

          <!-- STEP 01 -->
          <div class="config-step">
            <span class="config-step-num">단계 01</span>
            <h3>수출 시장</h3>
            <p>
              제품은 어디에서 판매되나요? 시장에 따라 적합성·형태·맛의 방향성에
              관한 당사 제안이 달라집니다——해당하는 항목을 모두 선택해 주세요.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">동남아시아</button>
              <button type="button">동아시아(일본/한국)</button>
              <button type="button">유럽</button>
              <button type="button">북미</button>
              <button type="button">남미</button>
              <button type="button">중동·아프리카</button>
              <button type="button">오세아니아</button>
              <button type="button">복수/기타 시장</button>
            </div>
          </div>

          <!-- STEP 02 -->
          <div class="config-step">
            <span class="config-step-num">단계 02</span>
            <h3>제품 유형</h3>
            <p>
              브랜드의 베이스 제품을 선택해 주세요——중국 정통부터 국제 스타일
              까지, 모두 동일한 밀 기술로 대응합니다.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">중국식 건면</button>
              <button type="button">라면</button>
              <button type="button">우동</button>
              <button type="button">소바/메밀면</button>
              <button type="button">스파게티</button>
              <button type="button">면대(반죽 시트)</button>
              <button type="button">중국 지방 시리즈</button>
              <button type="button">독자 제품 유형</button>
            </div>
          </div>

          <!-- STEP 03 -->
          <div class="config-step">
            <span class="config-step-num">단계 03</span>
            <h3>원료</h3>
            <p>
              포지셔닝에 맞춰 밀가루 베이스를 선택해 주세요——합리적인 일상용
              부터 프리미엄·건강 지향까지($ = 대략적인 가격대).
            </p>
            <div class="config-options" data-config-group>
              <button type="button">표준 밀가루 $</button>
              <button type="button">밀 배유분 $$</button>
              <button type="button">고글루텐 밀가루 $$</button>
              <button type="button">통밀가루 $$$</button>
              <button type="button">멀티그레인 블렌드 $$$</button>
              <button type="button">원료 지정하기</button>
            </div>
          </div>

          <!-- STEP 04 -->
          <div class="config-step">
            <span class="config-step-num">단계 04</span>
            <h3>배합 방향성</h3>
            <p>
              시장이 기대하는 식감을 알려주세요——또는 독자 레시피를 보내주시면
              양산용으로 조정합니다.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">쫄깃한 탄력 타입(동아시아)</button>
              <button type="button">부드럽고 빨리 삶기는 타입</button>
              <button type="button">파스타풍의 단단한 식감(알덴테)</button>
              <button type="button">통밀·고식이섬유</button>
              <button type="button">계란 함유</button>
              <button type="button">채소 함유 블렌드</button>
              <button type="button">자사 레시피 사용</button>
            </div>
          </div>

          <!-- STEP 05 -->
          <div class="config-step">
            <span class="config-step-num">단계 05</span>
            <h3>형상과 크기</h3>
            <p>
              면의 폭, 단면, 길이——중국 컷 번호와 그에 가까운 서양 파스타의
              대응을 보여드립니다.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">초극세 둥근면(No.0/엔젤헤어)</button>
              <button type="button">가는 둥근면(No.2/스파게티)</button>
              <button type="button">중간 굵기(No.3/링귀네)</button>
              <button type="button">넓은 납작면(No.6/페투치네)</button>
              <button type="button">광폭 컷(No.10/파파르델레)</button>
              <button type="button">독자 크기</button>
            </div>
          </div>

          <!-- STEP 06 -->
          <div class="config-step">
            <span class="config-step-num">단계 06</span>
            <h3>샘플 테스트</h3>
            <p>수량 약정 전에 제품을 확인해 주세요.</p>
            <div class="config-options" data-config-group>
              <button type="button">샘플 국제 배송</button>
              <button type="button">샘플 동영상 리뷰</button>
              <button type="button">공장 견학·감사</button>
            </div>
          </div>

          <!-- STEP 07 -->
          <div class="config-step">
            <span class="config-step-num">단계 07</span>
            <h3>품질과 인증</h3>
            <p>
              제품이 충족해야 할 기준을 모두 선택해 주세요——복수 선택 가능합니다.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">ISO 9001 / 22000 / HACCP(기본)</button>
              <button type="button">EU 시장 대응</button>
              <button type="button">미국 시장 대응</button>
              <button type="button">할랄 요건</button>
              <button type="button">제3자 시험소 검사</button>
              <button type="button">고객 지정 기준</button>
            </div>
          </div>

          <!-- STEP 08 -->
          <div class="config-step">
            <span class="config-step-num">단계 08</span>
            <h3>수량과 일정</h3>
            <p>
              채널에 맞춘 발주 페이스——소량부터 시작해 당사의 예비 생산 능력으로
              확장할 수 있습니다.
            </p>
            <div class="config-options" data-config-group>
              <button type="button">시험 주문(1컨테이너 이하)</button>
              <button type="button">월별 컨테이너 공급</button>
              <button type="button">분기 프로그램</button>
              <button type="button">연간 기본 계약</button>
              <button type="button">미정</button>
            </div>
          </div>

          <!-- STEP 09 -->
          <div class="config-step">
            <span class="config-step-num">단계 09</span>
            <h3>포장과 수출</h3>
            <p>
              채널에 맞는 포장 형태를 선택하고 배송 방법을 지정해 주세요.
            </p>
            <p class="config-group-label">포장 형태</p>
            <div class="config-options" data-config-group>
              <button type="button">소매용 필로우 포장</button>
              <button type="button">종이 띠 묶음 포장</button>
              <button type="button">손잡이 패밀리팩</button>
              <button type="button">업소용 HoReCa 카톤</button>
              <button type="button">완전 주문 제작 포장</button>
            </div>
            <p class="config-group-label">수출 조건</p>
            <div class="config-options" data-config-group>
              <button type="button">지정 항구까지 배송(CIF)</button>
              <button type="button">고객사가 운송 수배(FOB)</button>
              <button type="button">공장 인도(EXW)</button>
              <button type="button">상담이 필요</button>
            </div>
          </div>

          <!-- Save & contact -->
          <div class="config-step">
            <h3>이 구성으로 괜찮으신가요?</h3>
            <p>
              당사 수출팀에 보내주세요——샘플 방향성, 사양, 견적 경로를 회신해
              드립니다.
            </p>
            <div class="config-save-actions">
              <a class="config-save-link" href={withBase("/ko/contact/")}>
                저장하고 문의 보내기 <span aria-hidden="true">→</span>
              </a>
              <button type="button" class="config-reset" data-config-reset>
                초기화
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer showCta={false} lang="ko" />
    <script is:inline src={withBase("/scripts/site.js")} defer></script>

    <script>
      // Storage key for a group = its sub-label (step 9 has two groups) or,
      // failing that, the step's h3 title.
      function groupKey(step, group) {
        const prev = group.previousElementSibling;
        if (prev && prev.classList.contains("config-group-label")) {
          return prev.textContent.trim();
        }
        const h3 = step.querySelector("h3");
        return h3 ? h3.textContent.trim() : "";
      }

      // Every group is multi-select: click toggles a button on/off.
      document.querySelectorAll("[data-config-group] button").forEach((btn) => {
        btn.addEventListener("click", () => btn.classList.toggle("selected"));
      });

      // Clear every selection and the stored data. The Reset button and a
      // browser refresh both run this, which also resets the contact page
      // (it reads these same sessionStorage keys).
      function clearConfig() {
        document
          .querySelectorAll("[data-config-group] button.selected")
          .forEach((b) => b.classList.remove("selected"));
        sessionStorage.removeItem("lisheng-customization");
        sessionStorage.removeItem("lisheng-customization-types");
      }

      // Re-apply the saved picks (used when returning via "Edit").
      function restoreConfig() {
        let saved = null;
        try {
          const raw = sessionStorage.getItem("lisheng-customization");
          if (raw) saved = JSON.parse(raw);
        } catch (e) {}
        if (!saved) return;
        document.querySelectorAll(".config-step").forEach((step) => {
          step.querySelectorAll("[data-config-group]").forEach((group) => {
            const picked = saved[groupKey(step, group)] || [];
            group.querySelectorAll("button").forEach((b) => {
              if (picked.indexOf(b.textContent.trim()) !== -1) {
                b.classList.add("selected");
              }
            });
          });
        });
      }

      // On load: returning via "Edit" (?edit=1) restores the saved picks; any
      // other load — a fresh visit or a plain refresh — starts clean (which
      // also clears the contact page). After restoring we drop the ?edit flag,
      // so a later refresh resets as expected.
      if (new URLSearchParams(location.search).has("edit")) {
        restoreConfig();
        history.replaceState(null, "", location.pathname);
      } else {
        clearConfig();
      }

      const resetBtn = document.querySelector("[data-config-reset]");
      if (resetBtn) resetBtn.addEventListener("click", clearConfig);

      // Save & Send: collect selections, persist to sessionStorage, then jump
      // to the contact page with a flag so it shows the "filled" state.
      const saveLink = document.querySelector(".config-save-link");
      if (saveLink) {
        saveLink.addEventListener("click", (e) => {
          e.preventDefault();
          const selections = {};
          document.querySelectorAll(".config-step").forEach((step) => {
            step.querySelectorAll("[data-config-group]").forEach((group) => {
              const picked = Array.from(
                group.querySelectorAll("button.selected")
              ).map((b) => b.textContent.trim());
              if (picked.length) selections[groupKey(step, group)] = picked;
            });
          });

          sessionStorage.setItem(
            "lisheng-customization",
            JSON.stringify(selections)
          );
          sessionStorage.setItem(
            "lisheng-customization-types",
            JSON.stringify(selections["제품 유형"] || [])
          );

          const href = saveLink.getAttribute("href");
          const sep = href.indexOf("?") === -1 ? "?" : "&";
          // Land directly on the inquiry form (#quote-form) instead of the top.
          location.href = href + sep + "from=customization#quote-form";
        });
      }
    </script>
  </body>
</html>
